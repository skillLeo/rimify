    approval_documents {
        bigint id PK
        bigint supersedes_id FK
        bigint supplement_to_id FK
        string kind
        string kba_number
        int revision
        string status
        string pdf_key
        string pdf_sha256
        smallint page_count
        string completeness
    }
    approval_document_files {
        bigint id PK
        bigint approval_document_id FK
        string label
        date dated_on
        string sha256
        timestamp hidden_at
        tinyint is_main
    }
    document_conditions {
        bigint id PK
        bigint approval_document_id FK
        string code
        string kind
        string level
        text text_de
        smallint source_page
        string shop_colour
    }
    document_condition_reworks {
        bigint id PK
        bigint document_condition_id FK
    }
    document_fasteners {
        bigint id PK
        bigint approval_document_id FK
        smallint torque_nm
        smallint source_page
    }
    document_notices {
        bigint id PK
        bigint approval_document_id FK
        smallint source_page
    }
    document_vehicle_codes {
        bigint id PK
        bigint approval_document_id FK
        bigint vehicle_id FK
        string hsn
        string tsn
        string code
    }
    vehicles {
        bigint id PK
    }
