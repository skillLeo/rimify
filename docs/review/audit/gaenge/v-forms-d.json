{ "name": "v-forms-d", "start": "/admin/felgen/neu", "full": false, "steps": [
  { "select": "#fe-brand", "label": "Prüfrad" },
  { "fill": "#fe-name", "value": "straße 18" },
  { "fill": "#fe-type", "value": "pr18" },
  { "click": "role=button[name=\"Speichern\"]" },
  { "wait": 2000 },
  { "eval": "[location.pathname, document.querySelector('#fe-type-err')?.textContent?.trim(), document.querySelector('#fe-name')?.value, document.querySelector('#fe-type')?.value]" },
  { "goto": "/admin/reifen/neu" },
  { "eval": "[document.querySelectorAll('#rf-brand option').length, Array.from(document.querySelectorAll('#rf-brand option')).map(o => o.textContent.trim()).slice(0, 14)]" },
  { "goto": "/admin/gutachten/neu" },
  { "select": "#gn-kind", "value": "NACHTRAG" },
  { "wait": 500 },
  { "eval": "[!!document.querySelector('#gn-base-shorten'), document.querySelector('#gn-base-shorten')?.getAttribute('aria-label'), document.querySelectorAll('#gn-base option').length, Array.from(document.querySelectorAll('.rsf [role=status]')).map(e => e.textContent.trim())]" },
  { "fill": "#gn-base-shorten", "value": "MT-0001" },
  { "wait": 500 },
  { "eval": "[document.querySelectorAll('#gn-base option').length, Array.from(document.querySelectorAll('#gn-base option')).map(o => o.textContent.trim()).slice(0, 4), Array.from(document.querySelectorAll('.rsf [role=status]')).map(e => e.textContent.trim())]" },
  { "fill": "#gn-base-shorten", "value": "gibt-es-nicht" },
  { "wait": 500 },
  { "eval": "[document.querySelectorAll('#gn-base option').length, Array.from(document.querySelectorAll('.rsf [role=status]')).map(e => e.textContent.trim())]" },
  { "goto": "/admin/benutzer" },
  { "click": "main >> role=button[name=\"Person einladen\"]" },
  { "wait": 800 },
  { "eval": "Array.from(document.querySelectorAll('[role=dialog] input, [role=dialog] select, [role=dialog] button')).map(e => (e.id || e.name || e.textContent.trim()) + ':' + (e.type || ''))" }
] }
