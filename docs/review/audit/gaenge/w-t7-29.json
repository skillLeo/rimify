{ "name": "t7-29-rolle-zuweisen-loeschen", "start": "/admin/benutzer", "full": true, "steps": [
  { "click": "role=button[name=\"Aktionen für Nils Fuchs\"]" },
  { "wait": 300 },
  { "click": "[role=menu] >> role=menuitem[name=/Rolle/]" },
  { "wait": 500 },
  { "select": "[role=dialog] select", "value": "8" },
  { "eval": "document.querySelector('[role=dialog]')?.innerText?.slice(0, 700)" },
  { "click": "[role=dialog] >> role=button[name=/ändern|speichern|übernehmen/i]" },
  { "wait": 1800 },
  { "eval": "[document.querySelector('[role=dialog]') ? document.querySelector('[role=dialog]').innerText.slice(0, 500) : 'zu', Array.from(document.querySelectorAll('.form-field__error, .adm-alert, [role=alert]')).map(e => e.textContent.trim()).filter(Boolean), location.pathname]" },
  { "goto": "/admin/rollen?rolle=8" },
  { "wait": 1000 },
  { "click": "role=button[name=\"Weitere Aktionen für Prüfung Außendienst\"]" },
  { "wait": 300 },
  { "eval": "Array.from(document.querySelectorAll('[role=menu] [role=menuitem]')).map(m => m.textContent.trim() + (m.getAttribute('aria-disabled') === 'true' || m.hasAttribute('data-disabled') ? ' (gesperrt)' : ''))" },
  { "click": "[role=menu] >> role=menuitem[name=/Löschen|Entfernen/]" },
  { "wait": 500 },
  { "eval": "document.querySelector('[role=dialog]')?.innerText ?? null" },
  { "click": "[role=dialog] >> role=button[name=/Löschen|Entfernen/]", "timeout": 4000 },
  { "wait": 1500 },
  { "eval": "[document.querySelector('[role=dialog]') ? document.querySelector('[role=dialog]').innerText.slice(0, 500) : 'zu', Array.from(document.querySelectorAll('.form-field__error, .adm-alert, [role=alert]')).map(e => e.textContent.trim()).filter(Boolean)]" }
] }
