APP_NAME=RIMIFY
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ── Locale — German market, never change these ───────────
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE
APP_TIMEZONE=Europe/Berlin

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database — MySQL 8.4 (minimum 8.0.32), InnoDB, utf8mb4_0900_ai_ci, strict mode ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rimify
DB_USERNAME=rimify
DB_PASSWORD=rimify
DB_COLLATION=utf8mb4_0900_ai_ci

# ── Cache / queue / session — redis in production, database where Redis is absent ──
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail (Mailpit locally, Postmark/Brevo in production) ──
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@rimify.de
MAIL_FROM_NAME=RIMIFY

# ── Stripe: TEST keys only, typed in by hand (docs/dev/SECRETS.md) ─
# A live key never goes here: it is entered in the admin on the production site, and
# RIMIFY refuses a live key outside production and a key of the other mode.
STRIPE_MODE=test
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ── Inertia SSR ──────────────────────────────────────────
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714

# ── Rimify specific ──────────────────────────────────────
RIMIFY_PKWLISTE_IMPORT_PATH=storage/app/imports
RIMIFY_GUTACHTEN_DISK=local
RIMIFY_IMPORT_DELETE_THRESHOLD=0.15
RIMIFY_ENGINE_VERSION=1
# Testumgebung zurücksetzen (CLAUDE.md R-04.1): a test server's own yes, set by hand on that server — `true`, or
# `false` where it is meant to be off; the deploy refuses a test server without the line (deploy/check-env.php).
# Never in production, not even as false: the deploy and rimify:preflight refuse a live shop whose .env has it.
# RIMIFY_RESET_ERLAUBT=true
# The payment driver: none, sandbox (the review only) or stripe (once the three keys are in force).
# Unset: sandbox where the review is on, none elsewhere.
# RIMIFY_PAYMENTS=stripe
# The client's figures — a fallback only: Einstellungen › Verkäufer & Versand wins once it is saved, for the
# shipping and the seller alike. Empty: the checkout says „wird noch festgelegt“ and refuses a real order.
RIMIFY_SHIPPING_COST_CENTS=
RIMIFY_SHIPPING_FREE_FROM_CENTS=
RIMIFY_DELIVERY_TIME=
# The seller as the law names it (invoice, Widerrufsformular, order mail). Typed in by hand from the client's data.
RIMIFY_SELLER_NAME=
RIMIFY_SELLER_STREET=
RIMIFY_SELLER_ZIP=
RIMIFY_SELLER_CITY=
RIMIFY_SELLER_EMAIL=
RIMIFY_SELLER_VAT_ID=
RIMIFY_SELLER_TAX_NUMBER=
RIMIFY_SELLER_REGISTER=
# Kleinunternehmer under § 19 UStG: true changes the invoice, every price note and the order summaries together.
RIMIFY_SELLER_SMALL_BUSINESS=false
# The search by key numbers (HSN/TSN and the Fahrzeugschein scan): auto opens it once a vehicle dataset is loaded —
# an import or cars checked by hand, never the development seeds; on and off force it. A development copy, whose cars
# are seeds, sets on.
RIMIFY_FEATURE_KEY_NUMBERS=auto

VITE_APP_NAME="${APP_NAME}"

# Media storage (Einstellungen › Medien und Speicher). Names only — values are entered by hand in .env
# or, preferably, in the admin screen, which wins over these.
RIMIFY_S3_KEY=
RIMIFY_S3_SECRET=
RIMIFY_S3_REGION=eu-north-1
RIMIFY_S3_BUCKET=
RIMIFY_S3_URL=
RIMIFY_S3_ENDPOINT=
RIMIFY_S3_PATH_STYLE=false
