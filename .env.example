APP_NAME=RIMIFY
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ── Locale — German market, never change these ───────────
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE
APP_TIMEZONE=Europe/Berlin

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database — MySQL 8.4 (minimum 8.0.32), InnoDB, utf8mb4_0900_ai_ci, strict mode ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rimify
DB_USERNAME=rimify
DB_PASSWORD=rimify
DB_COLLATION=utf8mb4_0900_ai_ci

# ── Cache / queue / session — redis in production, database where Redis is absent ──
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail (Mailpit locally, Postmark/Brevo in production) ──
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@rimify.de
MAIL_FROM_NAME=RIMIFY

# ── Stripe (test keys until the client's account is live) ─
STRIPE_KEY=pk_test_replace_me
STRIPE_SECRET=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ── Inertia SSR ──────────────────────────────────────────
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714

# ── Rimify specific ──────────────────────────────────────
RIMIFY_PKWLISTE_IMPORT_PATH=storage/app/imports
RIMIFY_GUTACHTEN_DISK=local
RIMIFY_IMPORT_DELETE_THRESHOLD=0.15
RIMIFY_ENGINE_VERSION=1

VITE_APP_NAME="${APP_NAME}"
