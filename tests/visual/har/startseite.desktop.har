{"log":{"version":"1.2","creator":{"name":"Playwright","version":"1.63.0"},"browser":{"name":"chromium","version":"153.0.8010.12"},"pages":[{"startedDateTime":"2026-09-21T08:28:37.076Z","id":"page@9c871269fde4070b4eff5fb134003f54","title":"RIMIFY · Felgen mit Gutachten","pageTimings":{"onContentLoad":776,"onLoad":1229}}],"entries":[{"pageref":"page@9c871269fde4070b4eff5fb134003f54","startedDateTime":"2026-09-21T08:28:37.085Z","time":41.147999999999996,"request":{"method":"GET","url":"http://127.0.0.1:5500/desktop/startseite.html","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"},{"name":"Accept-Language","value":"de-DE"},{"name":"Upgrade-Insecure-Requests","value":"1"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/153.0.8010.12 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[],"headersSize":506,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept-Ranges","value":"bytes"},{"name":"Connection","value":"keep-alive"},{"name":"Date","value":"Mon, 21 Sep 2026 08:28:37 GMT"},{"name":"Keep-Alive","value":"timeout=5"},{"name":"cache-control","value":"no-cache, no-store, must-revalidate"},{"name":"content-length","value":"11362"},{"name":"content-type","value":"text/html; charset=UTF-8"},{"name":"etag","value":"W/\"6192449487866205-11362-2026-09-21T05:40:51.475Z\""},{"name":"last-modified","value":"Mon, 21 Sep 2026 05:40:51 GMT"}],"content":{"size":11362,"mimeType":"text/html; charset=UTF-8","compression":0,"text":"<!doctype html>\n<html lang=\"de\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>RIMIFY · Felgen mit Gutachten</title>\n<link rel=\"stylesheet\" href=\"../shared/tokens.css\">\n<link rel=\"stylesheet\" href=\"../shared/components.css\">\n</head>\n<body class=\"is-desktop\" data-page=\"startseite\">\n<div id=\"top\"></div>\n<main id=\"main\">\n\n  <!-- 1 · HERO -->\n  <section style=\"position:relative;min-height:880px;overflow:hidden;background:#05070B\">\n    <div data-mount=\"hero-scene\" style=\"position:absolute;inset:0\"></div>\n    <div style=\"position:absolute;inset:0;pointer-events:none;background:linear-gradient(100deg,rgba(4,6,10,.94) 0%,rgba(4,6,10,.80) 38%,rgba(4,6,10,.28) 68%,rgba(4,6,10,.10) 100%)\"></div>\n    <div class=\"wrap\" style=\"position:relative;min-height:880px;padding-top:56px;padding-bottom:108px;display:flex;align-items:center\">\n      <div style=\"width:480px\">\n        <div class=\"rise\" style=\"font:700 11px/1.4 Lato,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#8FA6FF\">RIMIFY-CHECK · Freigabe geprüft</div>\n        <h1 lang=\"de\" class=\"display rise rise-1\" style=\"margin-top:14px;color:#fff\">Felgen, die zu deinem Auto passen.<br><span style=\"color:#8FA6FF\">Garantiert.</span></h1>\n        <p class=\"rise rise-2\" style=\"margin-top:16px;max-width:400px;font:400 17px/1.55 Lato,sans-serif;color:rgba(255,255,255,.80)\">Wähle dein Fahrzeug – wir zeigen dir nur Felgen, die dafür freigegeben sind.</p>\n        <div class=\"rise rise-3\" style=\"margin-top:28px;width:440px;background:#fff;border-radius:18px;box-shadow:var(--sh-2);overflow:hidden\">\n          <div style=\"background:var(--blue);color:#fff;font:700 15px/1 Lato,sans-serif;padding:16px 24px\">Fahrzeug wählen</div>\n          <div style=\"padding:24px\" data-mount=\"hero-selector\"></div>\n        </div>\n      </div>\n    </div>\n    <div style=\"position:absolute;left:0;right:0;bottom:0;height:52px;background:rgba(4,6,10,.55);border-top:1px solid rgba(255,255,255,.12);display:flex;align-items:center;justify-content:center\" data-mount=\"trust\"></div>\n  </section>\n\n  <!-- 2 · BRAND STRIP -->\n  <section style=\"height:96px;background:var(--surface);border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:flex;align-items:center\">\n    <div class=\"wrap\" style=\"width:100%;display:flex;align-items:center;justify-content:space-between\" data-mount=\"brandstrip\"></div>\n  </section>\n\n  <!-- 3 · MARKEN -->\n  <section class=\"sec white\">\n    <div class=\"wrap\">\n      <h2 class=\"h2\" style=\"text-align:center;margin-bottom:40px\">Entdecke die beliebtesten Felgenmarken</h2>\n      <div class=\"grid2\" data-mount=\"brandcards\"></div>\n    </div>\n  </section>\n\n  <!-- 4 · AUTO WÄHLEN -->\n  <section class=\"sec band\">\n    <div class=\"wrap\">\n      <h2 class=\"h2\" style=\"margin-bottom:32px\">Auto wählen, garantiert passende Felge finden</h2>\n      <div style=\"display:grid;grid-template-columns:repeat(8,1fr);gap:24px\" data-mount=\"tiles\"></div>\n      <a class=\"link\" style=\"margin-top:28px\" href=\"felgen-suchen.html\">Alle Marken anzeigen\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12h14M13.5 6.5L19 12l-5.5 5.5\"/></svg></a>\n    </div>\n  </section>\n\n  <!-- 5 · BESTSELLER -->\n  <section class=\"sec white\">\n    <div class=\"wrap\">\n      <div class=\"spread\" style=\"align-items:baseline;margin-bottom:36px\">\n        <h2 class=\"h2\">Bestseller aus Mai 2026</h2>\n        <a class=\"link\" href=\"felgen.html\">Alle Felgen ansehen\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12h14M13.5 6.5L19 12l-5.5 5.5\"/></svg></a>\n      </div>\n      <div class=\"grid4\" data-mount=\"bestseller\"></div>\n    </div>\n  </section>\n\n  <!-- 6 · DEIN VORTEIL -->\n  <section class=\"sec band\">\n    <div class=\"wrap\">\n      <div class=\"card raised pnl\" style=\"display:grid;grid-template-columns:46fr 54fr;overflow:hidden\">\n        <div class=\"pad-l\">\n          <div class=\"row\" style=\"gap:10px\">\n            <span class=\"h3\" style=\"font-size:20px\">Dein Vorteil:</span>\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\"><circle cx=\"10\" cy=\"10\" r=\"10\" fill=\"#1A44D4\"/><path d=\"M5.8 10.3l2.7 2.7 5.7-5.9\" stroke=\"#fff\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            <span class=\"h3 bl\" style=\"font-size:20px\">RIMIFY-CHECK</span>\n          </div>\n          <p class=\"body ink2\" style=\"margin-top:16px;max-width:460px\">Mit RIMIFY CHECK prüfen wir die Kompatibilität zwischen Fahrzeug und Felge. So kannst du sicher sein, dass deine Wunschfelge zu deinem Fahrzeug passt und zugelassen ist.</p>\n          <div class=\"wash\" style=\"margin-top:24px;padding:18px 20px\">\n            <div class=\"row\" style=\"gap:40px\">\n              <div><div class=\"micro\" style=\"color:var(--ink2)\">Fahrzeug</div><div class=\"mono\" style=\"margin-top:6px\">BMW M4 F82</div></div>\n              <div><div class=\"micro\" style=\"color:var(--ink2)\">Felge</div><div class=\"mono\" style=\"margin-top:6px\">Wheelforce CF.3</div></div>\n            </div>\n            <div style=\"height:1px;background:var(--bline);margin:16px 0\"></div>\n            <div class=\"row\" style=\"gap:10px\">\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\" style=\"flex:none\"><path d=\"M3.5 9.4l3.4 3.4 7.6-7.9\" stroke=\"#2E8B22\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n              <span style=\"font:700 14px/1.4 Lato,sans-serif\">Freigegeben – keine Eintragung erforderlich</span>\n            </div>\n          </div>\n          <a class=\"btn btn-p\" style=\"margin-top:24px\" href=\"rimify-check.html\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\"><circle cx=\"10\" cy=\"10\" r=\"9.2\" stroke=\"#fff\" stroke-width=\"1.6\"/><path d=\"M5.8 10.3l2.7 2.7 5.7-5.9\" stroke=\"#fff\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            RIMIFY-CHECK</a>\n        </div>\n        <div style=\"position:relative;min-height:460px;background:var(--ground);overflow:hidden\">\n          <div data-mount=\"car-check\" style=\"position:absolute;inset:0\"></div>\n          <svg viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\" style=\"position:absolute;inset:0;width:100%;height:100%;pointer-events:none\">\n            <line x1=\"0\" y1=\"46\" x2=\"44\" y2=\"56\" stroke=\"#1A44D4\" stroke-width=\"0.25\" vector-effect=\"non-scaling-stroke\"/>\n            <line x1=\"0\" y1=\"58\" x2=\"26\" y2=\"76\" stroke=\"#1A44D4\" stroke-width=\"0.25\" vector-effect=\"non-scaling-stroke\"/>\n            <circle cx=\"44\" cy=\"56\" r=\"0.7\" fill=\"#1A44D4\" vector-effect=\"non-scaling-stroke\"/>\n            <circle cx=\"26\" cy=\"76\" r=\"0.7\" fill=\"#1A44D4\" vector-effect=\"non-scaling-stroke\"/>\n          </svg>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- 7 · WARUM RIMIFY -->\n  <section class=\"sec white\">\n    <div class=\"wrap\">\n      <h2 class=\"h2\" style=\"margin-bottom:40px\">Warum RIMIFY?</h2>\n      <div style=\"display:grid;grid-template-columns:repeat(3,1fr)\" data-mount=\"warum\"></div>\n    </div>\n  </section>\n\n  <!-- 8 · FELGENPAKET -->\n  <section class=\"sec band\">\n    <div class=\"wrap\">\n      <div class=\"card raised pnl\" style=\"display:grid;grid-template-columns:42fr 58fr;overflow:hidden\">\n        <div data-mount=\"scene-lager\" style=\"min-height:400px\"></div>\n        <div class=\"pad-l\">\n          <h2 class=\"h2\">Dein Felgenpaket</h2>\n          <div style=\"margin-top:28px;border:1px solid var(--line);border-radius:14px;padding:22px 24px\">\n            <div class=\"micro\">Lieferung</div>\n            <div style=\"margin-top:14px;display:flex;flex-direction:column;gap:10px\">\n              <div class=\"row\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 18 18\" fill=\"none\" style=\"flex:none\"><path d=\"M3.5 9.4l3.4 3.4 7.6-7.9\" stroke=\"#4A5160\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span style=\"font:400 15px/1.4 Lato,sans-serif\">Felgen</span></div>\n              <div class=\"row\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 18 18\" fill=\"none\" style=\"flex:none\"><path d=\"M3.5 9.4l3.4 3.4 7.6-7.9\" stroke=\"#4A5160\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span style=\"font:400 15px/1.4 Lato,sans-serif\">inkl. Anbauset &amp; ABE</span></div>\n            </div>\n          </div>\n          <div style=\"margin-top:16px;background:var(--wash);border:1px solid var(--blue);border-radius:14px;padding:22px 24px\">\n            <div class=\"row\" style=\"gap:12px\"><span class=\"pill pill-blue\">Empfohlen</span><span class=\"h4\">Komplettrad</span></div>\n            <div style=\"margin-top:14px;display:flex;flex-direction:column;gap:10px\">\n              <div class=\"row\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 18 18\" fill=\"none\" style=\"flex:none\"><path d=\"M3.5 9.4l3.4 3.4 7.6-7.9\" stroke=\"#1A44D4\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span style=\"font:400 15px/1.4 Lato,sans-serif\">inkl. Montage der Reifen auf die Felgen</span></div>\n              <div class=\"row\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 18 18\" fill=\"none\" style=\"flex:none\"><path d=\"M3.5 9.4l3.4 3.4 7.6-7.9\" stroke=\"#1A44D4\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span style=\"font:400 15px/1.4 Lato,sans-serif\">inkl. Wuchten</span></div>\n              <div class=\"row\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 18 18\" fill=\"none\" style=\"flex:none\"><path d=\"M3.5 9.4l3.4 3.4 7.6-7.9\" stroke=\"#1A44D4\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span style=\"font:400 15px/1.4 Lato,sans-serif\">inkl. Ventile &amp; Gewichte</span></div>\n            </div>\n          </div>\n          <a class=\"btn btn-p btn-full\" style=\"margin-top:24px\" href=\"felgen-suchen.html\">Jetzt Auto wählen und passende Felgen finden\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12h14M13.5 6.5L19 12l-5.5 5.5\"/></svg></a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- 9 · FAQ -->\n  <section class=\"sec white\" style=\"padding-bottom:112px\">\n    <div class=\"wrap\" style=\"display:grid;grid-template-columns:62fr 38fr;gap:40px;align-items:start\">\n      <div>\n        <h2 class=\"h2\" style=\"margin-bottom:28px\">Meistgestellte Fragen</h2>\n        <div data-mount=\"faq-home\"></div>\n      </div>\n      <div class=\"card raised pad\">\n        <h3 class=\"h4\">Weitere Fragen oder Unterstützung benötigt?</h3>\n        <div style=\"margin-top:20px\" data-mount=\"contact-rows\"></div>\n        <p class=\"body ink2\" style=\"margin-top:20px;font-size:15px\">Wir freuen uns von dir zu hören.</p>\n        <div style=\"margin-top:18px;border-radius:10px;overflow:hidden\" data-mount=\"scene-werkstatt\"></div>\n        <a class=\"btn btn-s btn-full\" style=\"margin-top:18px\" href=\"kontakt.html\">Zum Kontaktformular</a>\n      </div>\n    </div>\n  </section>\n\n</main>\n<div id=\"bottom\"></div>\n<script src=\"../shared/data.js\"></script>\n<script src=\"../shared/art.js\"></script>\n<script src=\"../shared/pages.js\"></script>\n<script src=\"../shared/pages2.js\"></script>\n<script src=\"../shared/admin.js\"></script>\n<script src=\"../shared/app.js\"></script>\n</body>\n</html>\n"},"headersSize":345,"bodySize":11362,"redirectURL":"","_transferSize":11707},"cache":{},"timings":{"dns":1.535,"connect":8.41,"ssl":11.834,"send":0,"wait":4.642,"receive":14.727},"_frameref":"frame@e04ba33566298ed83d8d9c601e342ca9","_monotonicTime":949.233,"_resourceType":"document","serverIPAddress":"127.0.0.1","_serverPort":5500,"_securityDetails":{}},{"pageref":"page@9c871269fde4070b4eff5fb134003f54","startedDateTime":"2026-09-21T08:28:37.124Z","time":15.834,"request":{"method":"GET","url":"http://127.0.0.1:5500/shared/tokens.css","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"text/css,*/*;q=0.1"},{"name":"Accept-Language","value":"de-DE"},{"name":"Referer","value":"http://127.0.0.1:5500/desktop/startseite.html"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/153.0.8010.12 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[],"headersSize":409,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept-Ranges","value":"bytes"},{"name":"Connection","value":"keep-alive"},{"name":"Date","value":"Mon, 21 Sep 2026 08:28:37 GMT"},{"name":"Keep-Alive","value":"timeout=5"},{"name":"cache-control","value":"no-cache, no-store, must-revalidate"},{"name":"content-length","value":"3878"},{"name":"content-type","value":"text/css; charset=UTF-8"},{"name":"etag","value":"W/\"3940649674180850-3878-2026-09-21T05:31:30.760Z\""},{"name":"last-modified","value":"Mon, 21 Sep 2026 05:31:30 GMT"}],"content":{"size":3878,"mimeType":"text/css; charset=UTF-8","compression":0,"text":"/* RIMIFY — tokens, reset, type scale */\n@import url('https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,400;0,700;0,900;1,900&family=IBM+Plex+Mono:wght@400;500&display=swap');\n\n:root{\n  --blue:#1A44D4; --blue-h:#1F4EE8; --blue-p:#1536AE;\n  --wash:#EAEEFA; --bline:#C9D4F5; --hi:#8FA6FF;\n  --black:#000000; --ink:#0E1116; --ink2:#4A5160; --ink3:#7B8394;\n  --ground:#F7F8FD; --band:#F2F5FC; --surface:#FFFFFF;\n  --field:#F5F5F5; --row:#E9E9E9; --line:#E5E5E5; --line-s:#EEF0F5;\n  --ok:#2E8B22; --ok-w:#E8F4E5;\n  --warn:#9A6400; --warn-w:#FBF1DC;\n  --danger:#B01018; --danger-w:#FBE8E8;\n  --star:#F9C112;\n  --sh-1:0 1px 2px rgba(14,17,22,.05),0 8px 24px -14px rgba(14,17,22,.16);\n  --sh-2:0 2px 4px rgba(14,17,22,.06),0 18px 40px -18px rgba(14,17,22,.22);\n  --e1:120ms ease-out;\n  --e2:180ms cubic-bezier(.2,.8,.2,1);\n  --e3:240ms cubic-bezier(.2,.8,.2,1);\n}\n\n*,*::before,*::after{box-sizing:border-box}\nhtml{-webkit-text-size-adjust:100%}\nbody{\n  margin:0;background:var(--ground);color:var(--ink);\n  font:400 16px/1.6 Lato,\"Helvetica Neue\",Arial,sans-serif;\n  -webkit-font-smoothing:antialiased;overflow-x:hidden;\n}\nimg,svg{display:block;max-width:100%}\nbutton{font:inherit;border:0;background:none;cursor:pointer;color:inherit}\ninput,select,textarea{font:inherit;color:inherit}\na{color:var(--blue);text-decoration:none}\na:hover{color:var(--blue-h);text-decoration:underline}\nh1,h2,h3,h4,p{margin:0}\nul{margin:0;padding:0;list-style:none}\n:focus-visible{outline:2px solid var(--blue);outline-offset:2px;border-radius:4px}\n::placeholder{color:var(--ink3)}\n::selection{background:var(--wash)}\n\n/* ── type ─────────────────────────────────────────────── */\n.display{font:900 56px/1.06 Lato,sans-serif;letter-spacing:-.03em;text-wrap:balance}\n.h2{font:700 34px/1.2 Lato,sans-serif;letter-spacing:-.02em;text-wrap:balance}\n.h3{font:700 20px/1.3 Lato,sans-serif;letter-spacing:-.01em}\n.h4{font:700 18px/1.3 Lato,sans-serif;letter-spacing:-.01em}\n.body{font:400 16px/1.6 Lato,sans-serif;text-wrap:pretty}\n.lab{font:700 14px/1 Lato,sans-serif}\n.micro{font:700 11px/1 Lato,sans-serif;letter-spacing:.10em;text-transform:uppercase;color:var(--ink3)}\n.mono,.num{font-variant-numeric:tabular-nums}\n.mono{font:500 13px/1.35 \"IBM Plex Mono\",ui-monospace,monospace;letter-spacing:.01em}\n.ink2{color:var(--ink2)} .ink3{color:var(--ink3)} .bl{color:var(--blue)}\n.wordmark{font:italic 900 25px/1 Lato,sans-serif;letter-spacing:-.02em;transform:skewX(-6deg);display:inline-block}\n\nbody.is-mobile .display{font-size:34px}\nbody.is-mobile .h2{font-size:25px}\nbody.is-mobile .h3{font-size:18px}\nbody.is-mobile .body{font-size:15px}\n\n/* ── layout ───────────────────────────────────────────── */\n.wrap{max-width:1280px;margin:0 auto;padding:0 40px}\n.sec{padding:96px 0}\n.sec-s{padding:64px 0}\n.band{background:var(--band)}\n.white{background:var(--surface)}\nbody.is-mobile .wrap{max-width:390px;padding:0 16px}\nbody.is-mobile .sec{padding:56px 0}\nbody.is-mobile .sec-s{padding:40px 0}\n.row{display:flex;align-items:center;gap:12px}\n.col{display:flex;flex-direction:column}\n.spread{display:flex;align-items:center;justify-content:space-between;gap:24px}\n.grow{flex:1;min-width:0}\n.hide{display:none!important}\n\n@media (prefers-reduced-motion:reduce){\n  *,*::before,*::after{animation-duration:.001ms!important;animation-delay:0ms!important;transition-duration:.001ms!important}\n}\n@keyframes rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}\n@keyframes slideIn{from{opacity:0;transform:translateX(12px)}to{opacity:1;transform:none}}\n.rise{animation:rise .4s cubic-bezier(.2,.8,.2,1) both}\n.rise-1{animation-delay:.06s}.rise-2{animation-delay:.12s}.rise-3{animation-delay:.18s}\n"},"headersSize":342,"bodySize":3878,"redirectURL":"","_transferSize":4220},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":2.864,"receive":12.97},"_frameref":"frame@e04ba33566298ed83d8d9c601e342ca9","_monotonicTime":985.589,"_resourceType":"stylesheet","serverIPAddress":"127.0.0.1","_serverPort":5500,"_securityDetails":{}},{"pageref":"page@9c871269fde4070b4eff5fb134003f54","startedDateTime":"2026-09-21T08:28:37.124Z","time":25.239,"request":{"method":"GET","url":"http://127.0.0.1:5500/shared/components.css","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"text/css,*/*;q=0.1"},{"name":"Accept-Language","value":"de-DE"},{"name":"Referer","value":"http://127.0.0.1:5500/desktop/startseite.html"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/153.0.8010.12 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[],"headersSize":413,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept-Ranges","value":"bytes"},{"name":"Connection","value":"keep-alive"},{"name":"Date","value":"Mon, 21 Sep 2026 08:28:37 GMT"},{"name":"Keep-Alive","value":"timeout=5"},{"name":"cache-control","value":"no-cache, no-store, must-revalidate"},{"name":"content-length","value":"25397"},{"name":"content-type","value":"text/css; charset=UTF-8"},{"name":"etag","value":"W/\"2814749767327790-25397-2026-09-21T05:33:04.389Z\""},{"name":"last-modified","value":"Mon, 21 Sep 2026 05:33:04 GMT"}],"content":{"size":25397,"mimeType":"text/css; charset=UTF-8","compression":0,"text":"/* RIMIFY — components */\n\n/* ── buttons ─────────────────────────────────────────── */\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;height:48px;padding:0 24px;\n  border-radius:8px;font:700 14px/1 Lato,sans-serif;transition:background var(--e1),transform var(--e1),border-color var(--e1),color var(--e1)}\n.btn svg{flex:none}\n.btn-p{background:var(--blue);color:#fff}\n.btn-p:hover{background:var(--blue-h);transform:translateY(-1px);box-shadow:var(--sh-1);color:#fff;text-decoration:none}\n.btn-p:active{background:var(--blue-p);transform:translateY(0);box-shadow:none}\n.btn-s{background:#fff;border:1px solid var(--line);color:var(--ink)}\n.btn-s:hover{border-color:var(--blue);color:var(--blue);text-decoration:none}\n.btn-q{color:var(--blue);border:1px solid transparent;background:none}\n.btn-q:hover{border-color:var(--blue);text-decoration:none}\n.btn-full{width:100%}\n.btn-lg{height:52px;font-size:15px}\n.btn-xl{height:56px;font-size:16px}\n.btn:disabled,.btn[aria-disabled=true]{background:var(--line);color:var(--ink3);cursor:not-allowed;transform:none;box-shadow:none;border-color:transparent}\nbody.is-mobile .btn{height:52px}\n.link{display:inline-flex;align-items:center;gap:8px;font:700 14px/1 Lato,sans-serif;color:var(--blue)}\n.link:hover{text-decoration:none;color:var(--blue-h)}\n.spin{width:18px;height:18px;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;animation:sp .7s linear infinite}\n@keyframes sp{to{transform:rotate(360deg)}}\n\n/* ── surfaces ────────────────────────────────────────── */\n.card{background:#fff;border:1px solid var(--line);border-radius:14px}\n.card.raised{border-color:var(--line);box-shadow:var(--sh-1)}\n.card.lifted{box-shadow:var(--sh-2)}\n.card.pnl{border-radius:18px}\n.pad{padding:24px} .pad-l{padding:40px} .pad-s{padding:20px}\nbody.is-mobile .pad-l{padding:20px}\n.wash{background:var(--wash);border-radius:10px;padding:16px 18px}\n.hr{height:1px;background:var(--line);border:0;margin:0}\n.hr-s{height:1px;background:var(--line-s);border:0;margin:0}\n.hr-inset{height:1px;background:var(--line-s);margin:0 20px}\n\n/* ── inputs ──────────────────────────────────────────── */\n.field{width:100%;height:48px;border:0;border-radius:8px;background:var(--field);padding:0 16px;\n  font:400 15px/1 Lato,sans-serif;outline:none;transition:box-shadow var(--e1),background var(--e1)}\n.field:focus{background:#fff;box-shadow:0 0 0 1px var(--blue),0 0 0 4px var(--wash)}\n.field.err{background:#fff;box-shadow:0 0 0 1px var(--danger)}\n.field-mono{font:500 16px/1 \"IBM Plex Mono\",monospace;letter-spacing:.14em;text-transform:uppercase}\ntextarea.field{height:140px;padding:14px 16px;line-height:1.6;resize:vertical}\nselect.field{appearance:none;padding-right:40px;\n  background-image:url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' fill='none'><path d='M4 6.5l4 4 4-4' stroke='%237B8394' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/></svg>\");\n  background-repeat:no-repeat;background-position:right 14px center}\n.flabel{display:block;font:700 14px/1 Lato,sans-serif;margin-bottom:8px}\n.req{color:var(--danger)}\n.ferr{margin-top:6px;font:400 13px/1.4 Lato,sans-serif;color:var(--danger)}\n.ffield{position:relative}\n.ffield .ic{position:absolute;top:50%;transform:translateY(-50%);color:var(--ink3);pointer-events:none}\n.ffield .ic.l{left:14px} .ffield .ic.r{right:14px}\n.ffield .field.pl{padding-left:44px}\nbody.is-mobile .field{height:52px}\n.check{display:flex;align-items:flex-start;gap:10px;cursor:pointer;min-height:44px;padding:4px 0}\n.check input{width:20px;height:20px;accent-color:var(--blue);margin:2px 0 0;flex:none}\n\n/* ── chips & pills ───────────────────────────────────── */\n.chip{min-width:44px;height:44px;padding:0 12px;border-radius:999px;background:var(--ground);color:var(--ink2);\n  display:inline-flex;align-items:center;justify-content:center;\n  font:500 13px/1 \"IBM Plex Mono\",monospace;font-variant-numeric:tabular-nums;transition:background var(--e1),color var(--e1)}\n.chip:hover{background:var(--wash)}\n.chip[aria-pressed=true]{background:var(--blue);color:#fff}\n.chip[disabled]{opacity:.45;cursor:not-allowed;text-decoration:line-through;text-decoration-thickness:1px}\n.chip[disabled]:hover{background:var(--ground)}\n.chips{display:flex;flex-wrap:wrap;gap:8px}\n.pill{display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 10px;border-radius:999px;\n  font:700 11px/1 Lato,sans-serif;letter-spacing:.06em;text-transform:uppercase}\n.pill-ok{background:var(--ok-w);color:var(--ok)}\n.pill-warn{background:var(--warn-w);color:var(--warn)}\n.pill-danger{background:var(--danger-w);color:var(--danger)}\n.pill-blue{background:var(--blue);color:#fff}\n.pill-ink{background:var(--ground);color:var(--ink2)}\n.dot{width:8px;height:8px;border-radius:999px;flex:none}\n\n/* ── header ──────────────────────────────────────────── */\n.bluebar{background:var(--blue);color:#fff;min-height:40px;display:flex;align-items:center;justify-content:center;\n  gap:12px;font:400 13px/1.3 Lato,sans-serif;padding:8px 16px;text-align:center}\n.bluebar a{color:#fff;text-decoration:underline;text-underline-offset:3px}\n.hdr{background:#000;height:76px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0 40px;position:relative;z-index:40}\n.hdr .wordmark{color:#fff;justify-self:start}\n.hnav{display:flex;align-items:center;gap:36px}\n.hnav a{position:relative;font:700 14px/1 Lato,sans-serif;color:rgba(255,255,255,.88);padding:10px 0;display:flex;align-items:center;gap:8px}\n.hnav a::after{content:\"\";position:absolute;left:0;right:100%;bottom:0;height:2px;background:var(--blue);transition:right 160ms ease-out}\n.hnav a:hover{color:#fff;text-decoration:none}\n.hnav a:hover::after,.hnav a[aria-current=page]::after{right:0}\n.hcart{display:flex;flex-direction:column;align-items:center;gap:3px;color:#fff;position:relative}\n.hcart:hover{text-decoration:none}\n.hcart span{font:400 11px/1 Lato,sans-serif;color:rgba(255,255,255,.88)}\n.badge{position:absolute;top:-4px;right:2px;min-width:16px;height:16px;padding:0 4px;border-radius:999px;\n  background:var(--blue);color:#fff;font:700 10px/16px Lato,sans-serif;text-align:center}\n.hright{display:flex;justify-content:flex-end}\n.vbox{background:#fff;border-radius:8px;padding:10px 20px;text-align:center;cursor:pointer;position:relative}\n.vbox .l1{font:700 11px/1 Lato,sans-serif;color:var(--ink2)}\n.vbox .l2{font:700 13px/1.2 Lato,sans-serif;color:var(--ink);margin-top:3px;font-variant-numeric:tabular-nums}\n.vpop{position:absolute;top:calc(100% + 10px);left:50%;transform:translateX(-50%);width:260px;background:#fff;\n  border-radius:12px;box-shadow:var(--sh-2);padding:8px;text-align:left;z-index:50}\n.vpop button{display:block;width:100%;text-align:left;padding:12px;border-radius:8px;font:400 14px/1 Lato,sans-serif;min-height:44px}\n.vpop button:hover{background:var(--ground)}\nbody.is-mobile .hdr{height:60px;display:flex;justify-content:space-between;padding:0 16px}\nbody.is-mobile .hdr .wordmark{font-size:21px}\n.burger{width:44px;height:44px;display:flex;align-items:center;justify-content:center;color:#fff}\n\n/* ── footer ──────────────────────────────────────────── */\n.ftr{background:#000;color:#fff;padding:64px 0 28px}\n.ftr .cols{display:grid;grid-template-columns:1.5fr 1fr 1fr 1.4fr;gap:48px}\n.ftr p{color:rgba(255,255,255,.62);font:400 14px/1.7 Lato,sans-serif;max-width:300px}\n.ftr .micro{color:rgba(255,255,255,.45)}\n.ftr a{color:rgba(255,255,255,.78);font:400 14px/1 Lato,sans-serif}\n.ftr a:hover{color:#fff;text-decoration:none}\n.ftr .links{display:flex;flex-direction:column;gap:12px;margin-top:18px}\n.soc{display:flex;gap:18px;margin-top:24px}\n.soc a{color:#fff;opacity:.7;transition:opacity var(--e1)}\n.soc a:hover{opacity:1}\n.ftr .nl input{width:100%;height:48px;border:1px solid rgba(255,255,255,.18);border-radius:8px;\n  background:rgba(255,255,255,.06);padding:0 14px;color:#fff;outline:none;font:400 15px/1 Lato,sans-serif}\n.ftr .btm{border-top:1px solid rgba(255,255,255,.10);margin-top:48px;padding-top:20px;text-align:center;\n  font:400 13px/1 Lato,sans-serif;color:rgba(255,255,255,.45)}\nbody.is-mobile .ftr{padding:48px 0 24px}\nbody.is-mobile .ftr .cols{grid-template-columns:1fr}\nbody.is-mobile .ftr .cols .two{display:grid;grid-template-columns:1fr 1fr;gap:24px}\n\n/* ── bottom nav (mobile) ─────────────────────────────── */\n.bnav{position:fixed;left:0;right:0;bottom:0;background:#fff;border-top:1px solid var(--line);\n  padding:0 4px calc(8px + env(safe-area-inset-bottom));display:grid;grid-template-columns:repeat(5,1fr);\n  align-items:end;z-index:60}\n.bnav button{height:58px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:6px;\n  padding-bottom:2px;color:var(--ink3);position:relative}\n.bnav button span{font:700 10px/1 Lato,sans-serif;white-space:nowrap}\n.bnav button[aria-current=page]{color:var(--blue)}\n.bnav .mid{position:relative;height:58px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;color:var(--ink3)}\n.bnav .mid .fab{position:absolute;top:-16px;left:50%;transform:translateX(-50%);width:52px;height:52px;\n  border-radius:999px;background:var(--blue);color:#fff;display:flex;align-items:center;justify-content:center;\n  box-shadow:0 0 0 5px #fff,0 8px 20px -8px rgba(26,68,212,.65)}\n.bnav .mid span{font:700 10px/1 Lato,sans-serif;letter-spacing:-.01em;white-space:nowrap;padding-bottom:2px}\nbody.is-mobile main{padding-bottom:96px}\n\n/* ── product card ────────────────────────────────────── */\n.well{position:relative;aspect-ratio:1/1;border-radius:10px;background:linear-gradient(#FFFFFF,#FAFBFE);overflow:hidden}\n.well .art{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;transition:transform 240ms cubic-bezier(.2,.8,.2,1)}\n.well .stock{position:absolute;top:12px;right:12px}\n.pcard{background:#fff;border:1px solid var(--line);border-radius:14px;padding:20px;display:flex;flex-direction:column;\n  box-shadow:var(--sh-1);transition:box-shadow var(--e2)}\n.pcard:hover{box-shadow:var(--sh-2)}\n.pcard:hover .well .art{transform:scale(1.04)}\n.pcard .brand{margin-top:16px}\n.pcard .model{font:700 18px/1.2 Lato,sans-serif;letter-spacing:-.01em;margin-top:8px}\n.pcard .fin{font:400 14px/1.4 Lato,sans-serif;color:var(--ink2);margin-top:4px}\n.pcard .rate{display:flex;align-items:center;gap:6px;margin-top:8px;font-variant-numeric:tabular-nums}\n.pcard .star{color:var(--star);font-size:14px;line-height:1}\n.pcard .price{font:700 22px/1 Lato,sans-serif;font-variant-numeric:tabular-nums;margin-top:6px}\n.pcard .fit{display:flex;align-items:center;gap:8px;padding:10px 12px;border-radius:8px;font:700 13px/1.35 Lato,sans-serif}\n.fit-ok{background:var(--wash);color:var(--blue)}\n.fit-warn{background:var(--warn-w);color:var(--warn)}\n.fit-no{background:var(--danger-w);color:var(--danger)}\n.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}\n.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}\n.grid2{display:grid;grid-template-columns:1fr 1fr;gap:24px}\nbody.is-mobile .grid4,body.is-mobile .grid3,body.is-mobile .grid2{grid-template-columns:1fr;gap:16px}\n.rail{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 16px 8px;margin:0 -16px}\n.rail>*{flex:none;scroll-snap-align:start}\n\n/* ── accordion ───────────────────────────────────────── */\n.acc{background:#fff;border:1px solid var(--line);border-radius:10px;overflow:hidden}\n.acc.open{border-color:var(--blue)}\n.acc>button{width:100%;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px;\n  min-height:56px;text-align:left;font:700 15px/1.4 Lato,sans-serif;transition:background var(--e1)}\n.acc.open>button{background:var(--wash)}\n.acc>button svg{flex:none;color:var(--ink3);transition:transform var(--e2)}\n.acc.open>button svg{transform:rotate(180deg);color:var(--blue)}\n.acc .body{display:grid;grid-template-rows:0fr;transition:grid-template-rows var(--e2)}\n.acc.open .body{grid-template-rows:1fr}\n.acc .body>div{overflow:hidden}\n.acc .body p{padding:0 18px 18px;font:400 15px/1.7 Lato,sans-serif;color:var(--ink2)}\n.acc mark{background:var(--wash);color:inherit}\n.accs{display:flex;flex-direction:column;gap:12px}\n\n/* ── filter bar / segmented ──────────────────────────── */\n.fbar{background:#fff;border:1px solid var(--line);border-radius:12px;padding:8px;display:flex;align-items:center;flex-wrap:wrap}\n.fbar .sep{width:1px;align-self:stretch;margin:10px 4px;background:var(--line)}\n.fpill{display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 14px;border-radius:8px;\n  font:700 14px/1 Lato,sans-serif;transition:background var(--e1),color var(--e1)}\n.fpill:hover{background:var(--ground)}\n.fpill[aria-expanded=true]{background:var(--wash);color:var(--blue)}\n.fpill .cnt{background:var(--blue);color:#fff;border-radius:999px;padding:1px 7px;font:700 11px/1.5 Lato,sans-serif}\n.toggle{display:inline-flex;align-items:center;gap:10px;height:40px;padding:0 14px;border-radius:999px;\n  background:var(--ground);font:700 14px/1 Lato,sans-serif;color:var(--ink2)}\n.toggle[aria-pressed=true]{background:var(--blue);color:#fff}\n.fdrop{position:absolute;top:calc(100% + 8px);left:0;min-width:260px;background:#fff;border-radius:12px;\n  box-shadow:var(--sh-2);padding:8px;z-index:30;max-height:340px;overflow:auto}\n.fdrop label{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:8px;min-height:44px;cursor:pointer}\n.fdrop label:hover{background:var(--ground)}\n.fdrop label.off{opacity:.4;cursor:not-allowed}\n.fdrop .n{margin-left:auto;font:500 12px/1 \"IBM Plex Mono\",monospace;color:var(--ink3)}\n.seg{display:inline-flex;background:var(--ground);border-radius:999px;padding:4px;gap:4px}\n.seg button{height:40px;padding:0 18px;border-radius:999px;font:700 14px/1 Lato,sans-serif;color:var(--ink2)}\n.seg button[aria-pressed=true]{background:#fff;color:var(--ink);box-shadow:var(--sh-1)}\n\n/* ── tables ──────────────────────────────────────────── */\n.tbl{width:100%;border-collapse:collapse}\n.tbl th{text-align:left;padding:0 0 14px;font:700 11px/1 Lato,sans-serif;letter-spacing:.10em;text-transform:uppercase;color:var(--ink3)}\n.tbl td{padding:16px 0;border-top:1px solid var(--line-s);vertical-align:middle}\n.tbl .r{text-align:right;font-variant-numeric:tabular-nums}\n.tbl tbody tr:hover{background:var(--ground)}\n.step{display:inline-flex;align-items:center;height:44px;border:1px solid var(--line);border-radius:8px;overflow:hidden}\n.step button{width:40px;height:44px;display:flex;align-items:center;justify-content:center;color:var(--ink2)}\n.step button:hover{background:var(--ground)}\n.step input{width:46px;height:44px;border:0;text-align:center;background:none;font:700 15px/1 Lato,sans-serif;\n  font-variant-numeric:tabular-nums;outline:none}\n\n/* ── tiles / selection ───────────────────────────────── */\n.tile{background:#fff;border:1px solid var(--line);border-radius:10px;padding:12px;cursor:pointer;\n  transition:border-color var(--e1),background var(--e1);position:relative;text-align:left}\n.tile[aria-pressed=true]{border:2px solid var(--blue);background:var(--wash);padding:11px}\n.tile .tick{position:absolute;top:8px;right:8px;opacity:0;color:var(--blue)}\n.tile[aria-pressed=true] .tick{opacity:1}\n.mtile{aspect-ratio:1/1;background:#fff;border:1px solid var(--line);border-radius:14px;display:flex;\n  flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:0 10px;\n  transition:border-color var(--e1),transform var(--e1)}\n.mtile:hover{border-color:var(--blue);transform:translateY(-2px)}\n.mtile-l{display:flex;align-items:center;justify-content:center;height:38px;opacity:.76;transition:opacity var(--e1)}\n.mtile:hover .mtile-l{opacity:1}\n.mtile-n{font:700 11px/1 Lato,sans-serif;letter-spacing:.1em;color:var(--ink2);text-align:center;transition:color var(--e1)}\n.mtile:hover .mtile-n{color:var(--ink)}\nbody.is-mobile .mtile{gap:9px;border-radius:12px}\nbody.is-mobile .mtile-l{height:28px}\nbody.is-mobile .mtile-n{font-size:9px;letter-spacing:.08em}\n\n/* ── sheets, modals, toasts ──────────────────────────── */\n.scrim{position:fixed;inset:0;background:rgba(6,8,12,.55);z-index:70;opacity:0;pointer-events:none;transition:opacity var(--e3)}\n.scrim.on{opacity:1;pointer-events:auto}\n.sheet{position:fixed;left:0;right:0;bottom:0;max-height:92vh;background:#fff;border-radius:18px 18px 0 0;z-index:80;\n  transform:translateY(100%);transition:transform var(--e3);display:flex;flex-direction:column}\n.sheet.on{transform:none}\n.sheet header{padding:16px 16px 12px;border-bottom:1px solid var(--line-s);display:flex;align-items:center;justify-content:space-between}\n.sheet .sbody{overflow:auto;padding:16px;flex:1}\n.sheet footer{padding:12px 16px calc(12px + env(safe-area-inset-bottom));border-top:1px solid var(--line-s)}\n.modal{position:fixed;top:50%;left:50%;transform:translate(-50%,-48%);width:min(560px,92vw);background:#fff;\n  border-radius:18px;box-shadow:var(--sh-2);z-index:80;opacity:0;pointer-events:none;transition:opacity var(--e3),transform var(--e3)}\n.modal.on{opacity:1;pointer-events:auto;transform:translate(-50%,-50%)}\n.toast{position:fixed;left:50%;bottom:28px;transform:translate(-50%,16px);background:var(--ink);color:#fff;\n  padding:14px 20px;border-radius:10px;font:700 14px/1 Lato,sans-serif;z-index:90;opacity:0;pointer-events:none;\n  transition:opacity var(--e2),transform var(--e2);display:flex;align-items:center;gap:10px}\n.toast.on{opacity:1;transform:translate(-50%,0)}\nbody.is-mobile .toast{bottom:104px}\n\n/* ── misc ────────────────────────────────────────────── */\n.crumb{font:400 13px/1 Lato,sans-serif;color:var(--ink3);display:flex;gap:8px;align-items:center}\n.qmark{width:22px;height:22px;border-radius:999px;background:var(--wash);color:var(--blue);\n  font:700 12px/1 Lato,sans-serif;display:inline-flex;align-items:center;justify-content:center;flex:none}\n.qmark:hover{background:var(--bline)}\n\n/* ── mobile hit targets: nothing interactive under 44px ── */\nbody.is-mobile .qmark{width:44px;height:44px;font-size:15px}\nbody.is-mobile .ftr .links a{display:flex;align-items:center;min-height:44px}\nbody.is-mobile .ftr .soc a{width:44px;height:44px;display:inline-flex;align-items:center;justify-content:center}\nbody.is-mobile .bluebar{min-height:48px;padding-block:0}\nbody.is-mobile .bluebar a{display:inline-flex;align-items:center;min-height:44px;padding-inline:4px}\nbody.is-mobile .seg button{height:44px}\nbody.is-mobile .link{min-height:44px}\nbody.is-mobile .crumb a{display:inline-flex;align-items:center;min-height:44px}\nbody.is-mobile .hdr .wordmark,body.is-mobile .ftr .wordmark{display:inline-flex;align-items:center;min-height:44px}\nbody.is-mobile .legal a,body.is-mobile .ftr .btm a{display:inline-flex;align-items:center;min-height:44px}\nbody.is-mobile .pcard .model a{display:flex;align-items:center;min-height:44px}\nbody.is-mobile .chip{min-height:44px}\nbody.is-mobile .rev-link{display:inline-flex;align-items:center;min-height:44px}\nbody.is-mobile .check input{width:24px;height:24px}\nbody.is-mobile .check a{padding:8px 2px;margin:-8px -2px}\nbody.is-mobile .tap{display:inline-flex;align-items:center;min-height:44px}\n.crumb a{color:var(--ink3);text-decoration:underline;text-underline-offset:2px}\n.skel{background:linear-gradient(90deg,#EEF0F5,#F7F8FD,#EEF0F5);background-size:200% 100%;animation:sh 1.2s linear infinite;border-radius:6px}\n@keyframes sh{to{background-position:-200% 0}}\n.pager{display:flex;justify-content:center;gap:8px;margin-top:48px}\n.pager button{min-width:44px;height:44px;border-radius:8px;font:700 14px/1 Lato,sans-serif;color:var(--ink2)}\n.pager button:hover{background:var(--wash)}\n.pager button[aria-current=page]{background:var(--blue);color:#fff}\n.stepbar{display:flex;align-items:center;gap:12px}\n.stepbar .s{display:flex;align-items:center;gap:8px;font:700 13px/1 Lato,sans-serif;color:var(--ink3)}\n.stepbar .s.cur{color:var(--blue)}\n.stepbar .s.done{color:var(--ink2)}\n.stepbar .bar{width:40px;height:1px;background:var(--line)}\n.deflist{display:grid;grid-template-columns:auto 1fr;gap:0}\n.deflist dt{font:400 13px/1 Lato,sans-serif;color:var(--ink3);padding:12px 0;border-top:1px solid var(--line-s)}\n.deflist dd{margin:0;padding:12px 0;border-top:1px solid var(--line-s);text-align:right;\n  font:500 14px/1 \"IBM Plex Mono\",monospace;font-variant-numeric:tabular-nums}\n.deflist dt:first-of-type,.deflist dd:first-of-type{border-top:0}\n.sticky-bar{position:fixed;left:0;right:0;bottom:calc(72px + env(safe-area-inset-bottom));background:#fff;\n  border-top:1px solid var(--line);box-shadow:var(--sh-2);padding:10px 16px;display:flex;align-items:center;\n  justify-content:space-between;gap:12px;z-index:55;transform:translateY(120%);transition:transform var(--e3)}\n.sticky-bar.on{transform:none}\n\n/* ── admin shell ─────────────────────────────────────── */\n.adm{display:grid;grid-template-columns:248px 1fr;min-height:100vh;background:var(--ground)}\n.adm-side{background:var(--surface);border-right:1px solid var(--line);position:sticky;top:0;height:100vh;overflow:auto;\n  scrollbar-width:thin;scrollbar-color:var(--line) transparent}\n.adm-side::-webkit-scrollbar{width:8px}\n.adm-side::-webkit-scrollbar-thumb{background:var(--line);border-radius:999px;border:2px solid var(--surface)}\n.adm-side::-webkit-scrollbar-track{background:transparent}\n.adm-nav{display:flex;align-items:center;gap:10px;padding:0 16px;min-height:44px;\n  font:400 14px/1.3 Lato,sans-serif;color:var(--ink2);text-decoration:none;transition:color .12s ease-out,background .12s ease-out}\n.adm-nav-i{display:flex;width:20px;height:20px;flex:none;color:var(--ink3);transition:color .12s ease-out}\n.adm-nav-i svg{width:20px;height:20px}\n.adm-nav:hover{background:var(--band);color:var(--ink)}\n.adm-nav:hover .adm-nav-i{color:var(--ink2)}\n.adm-nav.on{background:var(--wash);color:var(--blue);font-weight:700;box-shadow:inset 2px 0 0 var(--blue)}\n.adm-nav.on .adm-nav-i{color:var(--blue)}\n.adm-main{min-width:0}\n.adm-top{height:60px;background:var(--surface);border-bottom:1px solid var(--line);display:flex;align-items:center;\n  justify-content:space-between;padding:0 24px;position:sticky;top:0;z-index:20;gap:12px}\n.adm-rail{display:none}\nbody.is-mobile .adm-rail{display:f