=device-width,initial-scale=1,viewport-fit=cover\">\n<title>RIMIFY-CHECK</title>\n<link rel=\"stylesheet\" href=\"../shared/tokens.css\">\n<link rel=\"stylesheet\" href=\"../shared/components.css\">\n</head>\n<body class=\"is-mobile\" data-page=\"rimify-check\">\n<div id=\"top\"></div>\n<main id=\"main\">\n  <section class=\"white\" style=\"padding:40px 0\">\n    <div class=\"wrap\" style=\"text-align:center\">\n      <div class=\"micro bl\" style=\"letter-spacing:.14em\">RIMIFY-CHECK</div>\n      <h1 class=\"display\" style=\"font-size:30px;margin-top:10px\">Passt diese Felge auf dein Auto?</h1>\n      <p class=\"body ink2\" style=\"margin-top:10px\">In zwei Schritten zur verbindlichen Antwort – mit dem Gutachten als Beleg.</p>\n    </div>\n  </section>\n\n  <div class=\"wrap\" style=\"padding-bottom:56px\">\n    <div class=\"card lifted pnl pad-s\">\n      <div class=\"row\" style=\"gap:10px\"><span style=\"width:28px;height:28px;border-radius:999px;background:var(--blue);color:#fff;display:flex;align-items:center;justify-content:center;font:700 13px/1 Lato,sans-serif;flex:none\">1</span>\n        <h2 class=\"h4\">Fahrzeug wählen</h2></div>\n      <div style=\"margin-top:14px\" data-mount=\"chk-step1\"></div>\n      <div class=\"hr\" style=\"margin:24px 0\"></div>\n      <div class=\"row\" style=\"gap:10px\"><span style=\"width:28px;height:28px;border-radius:999px;background:#fff;box-shadow:inset 0 0 0 1px var(--line);color:var(--ink2);display:flex;align-items:center;justify-content:center;font:700 13px/1 Lato,sans-serif;flex:none\">2</span>\n        <h2 class=\"h4\">Felge wählen</h2></div>\n      <div style=\"margin-top:14px\" data-mount=\"chk-step2\"></div>\n    </div>\n    <div style=\"margin-top:20px\" data-mount=\"chk-result\"></div>\n  </div>\n</main>\n<div id=\"bottom\"></div>\n<script src=\"../shared/data.js\"></script>\n<script src=\"../shared/art.js\"></script>\n<script src=\"../shared/pages.js\"></script>\n<script src=\"../shared/pages2.js\"></script>\n<script src=\"../shared/admin.js\"></script>\n<script src=\"../shared/app.js\"></script>\n</body>\n</html>\n"},"headersSize":343,"bodySize":2084,"redirectURL":"","_transferSize":2427},"cache":{},"timings":{"dns":0.29,"connect":0.442,"ssl":2.162,"send":0,"wait":2.659,"receive":11.55},"_frameref":"frame@0ae505f1a732736d1625028bc55564cb","_monotonicTime":69741.684,"_resourceType":"document","serverIPAddress":"127.0.0.1","_serverPort":5500,"_securityDetails":{}},{"pageref":"page@76b9a45bb084a7125d884186b129a128","startedDateTime":"2026-09-21T08:29:45.903Z","time":10.724,"request":{"method":"GET","url":"http://127.0.0.1:5500/shared/tokens.css","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"text/css,*/*;q=0.1"},{"name":"Accept-Language","value":"de-DE"},{"name":"Referer","value":"http://127.0.0.1:5500/mobile/rimify-check.html"},{"name":"User-Agent","value":"Mozilla/5.0 (Linux; Android 14; Pixel 7) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Mobile Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\""},{"name":"sec-ch-ua-mobile","value":"?1"},{"name":"sec-ch-ua-platform","value":"\"Android\""}],"queryString":[],"headersSize":404,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept-Ranges","value":"bytes"},{"name":"Connection","value":"keep-alive"},{"name":"Date","value":"Mon, 21 Sep 2026 08:29:45 GMT"},{"name":"Keep-Alive","value":"timeout=5"},{"name":"cache-control","value":"no-cache, no-store, must-revalidate"},{"name":"content-length","value":"3878"},{"name":"content-type","value":"text/css; charset=UTF-8"},{"name":"etag","value":"W/\"3940649674180850-3878-2026-09-21T05:31:30.760Z\""},{"name":"last-modified","value":"Mon, 21 Sep 2026 05:31:30 GMT"}],"content":{"size":3878,"mimeType":"text/css; charset=UTF-8","compression":0,"text":"/* RIMIFY — tokens, reset, type scale */\n@import url('https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,400;0,700;0,900;1,900&family=IBM+Plex+Mono:wght@400;500&display=swap');\n\n:root{\n  --blue:#1A44D4; --blue-h:#1F4EE8; --blue-p:#1536AE;\n  --wash:#EAEEFA; --bline:#C9D4F5; --hi:#8FA6FF;\n  --black:#000000; --ink:#0E1116; --ink2:#4A5160; --ink3:#7B8394;\n  --ground:#F7F8FD; --band:#F2F5FC; --surface:#FFFFFF;\n  --field:#F5F5F5; --row:#E9E9E9; --line:#E5E5E5; --line-s:#EEF0F5;\n  --ok:#2E8B22; --ok-w:#E8F4E5;\n  --warn:#9A6400; --warn-w:#FBF1DC;\n  --danger:#B01018; --danger-w:#FBE8E8;\n  --star:#F9C112;\n  --sh-1:0 1px 2px rgba(14,17,22,.05),0 8px 24px -14px rgba(14,17,22,.16);\n  --sh-2:0 2px 4px rgba(14,17,22,.06),0 18px 40px -18px rgba(14,17,22,.22);\n  --e1:120ms ease-out;\n  --e2:180ms cubic-bezier(.2,.8,.2,1);\n  --e3:240ms cubic-bezier(.2,.8,.2,1);\n}\n\n*,*::before,*::after{box-sizing:border-box}\nhtml{-webkit-text-size-adjust:100%}\nbody{\n  margin:0;background:var(--ground);color:var(--ink);\n  font:400 16px/1.6 Lato,\"Helvetica Neue\",Arial,sans-serif;\n  -webkit-font-smoothing:antialiased;overflow-x:hidden;\n}\nimg,svg{display:block;max-width:100%}\nbutton{font:inherit;border:0;background:none;cursor:pointer;color:inherit}\ninput,select,textarea{font:inherit;color:inherit}\na{color:var(--blue);text-decoration:none}\na:hover{color:var(--blue-h);text-decoration:underline}\nh1,h2,h3,h4,p{margin:0}\nul{margin:0;padding:0;list-style:none}\n:focus-visible{outline:2px solid var(--blue);outline-offset:2px;border-radius:4px}\n::placeholder{color:var(--ink3)}\n::selection{background:var(--wash)}\n\n/* ── type ─────────────────────────────────────────────── */\n.display{font:900 56px/1.06 Lato,sans-serif;letter-spacing:-.03em;text-wrap:balance}\n.h2{font:700 34px/1.2 Lato,sans-serif;letter-spacing:-.02em;text-wrap:balance}\n.h3{font:700 20px/1.3 Lato,sans-serif;letter-spacing:-.01em}\n.h4{font:700 18px/1.3 Lato,sans-serif;letter-spacing:-.01em}\n.body{font:400 16px/1.6 Lato,sans-serif;text-wrap:pretty}\n.lab{font:700 14px/1 Lato,sans-serif}\n.micro{font:700 11px/1 Lato,sans-serif;letter-spacing:.10em;text-transform:uppercase;color:var(--ink3)}\n.mono,.num{font-variant-numeric:tabular-nums}\n.mono{font:500 13px/1.35 \"IBM Plex Mono\",ui-monospace,monospace;letter-spacing:.01em}\n.ink2{color:var(--ink2)} .ink3{color:var(--ink3)} .bl{color:var(--blue)}\n.wordmark{font:italic 900 25px/1 Lato,sans-serif;letter-spacing:-.02em;transform:skewX(-6deg);display:inline-block}\n\nbody.is-mobile .display{font-size:34px}\nbody.is-mobile .h2{font-size:25px}\nbody.is-mobile .h3{font-size:18px}\nbody.is-mobile .body{font-size:15px}\n\n/* ── layout ───────────────────────────────────────────── */\n.wrap{max-width:1280px;margin:0 auto;padding:0 40px}\n.sec{padding:96px 0}\n.sec-s{padding:64px 0}\n.band{background:var(--band)}\n.white{background:var(--surface)}\nbody.is-mobile .wrap{max-width:390px;padding:0 16px}\nbody.is-mobile .sec{padding:56px 0}\nbody.is-mobile .sec-s{padding:40px 0}\n.row{display:flex;align-items:center;gap:12px}\n.col{display:flex;flex-direction:column}\n.spread{display:flex;align-items:center;justify-content:space-between;gap:24px}\n.grow{flex:1;min-width:0}\n.hide{display:none!important}\n\n@media (prefers-reduced-motion:reduce){\n  *,*::before,*::after{animation-duration:.001ms!important;animation-delay:0ms!important;transition-duration:.001ms!important}\n}\n@keyframes rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}\n@keyframes slideIn{from{opacity:0;transform:translateX(12px)}to{opacity:1;transform:none}}\n.rise{animation:rise .4s cubic-bezier(.2,.8,.2,1) both}\n.rise-1{animation-delay:.06s}.rise-2{animation-delay:.12s}.rise-3{animation-delay:.18s}\n"},"headersSize":342,"bodySize":3878,"redirectURL":"","_transferSize":4220},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":2.889,"receive":7.835},"_frameref":"frame@0ae505f1a732736d1625028bc55564cb","_monotonicTime":69760.93,"_resourceType":"stylesheet","serverIPAddress":"127.0.0.1","_serverPort":5500,"_securityDetails":{}},{"pageref":"page@76b9a45bb084a7125d884186b129a128","startedDateTime":"2026-09-21T08:29:45.903Z","time":14.209,"request":{"method":"GET","url":"http://127.0.0.1:5500/shared/components.css","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"text/css,*/*;q=0.1"},{"name":"Accept-Language","value":"de-DE"},{"name":"Referer","value":"http://127.0.0.1:5500/mobile/rimify-check.html"},{"name":"User-Agent","value":"Mozilla/5.0 (Linux; Android 14; Pixel 7) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Mobile Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\""},{"name":"sec-ch-ua-mobile","value":"?1"},{"name":"sec-ch-ua-platform","value":"\"Android\""}],"queryString":[],"headersSize":408,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept-Ranges","value":"bytes"},{"name":"Connection","value":"keep-alive"},{"name":"Date","value":"Mon, 21 Sep 2026 08:29:45 GMT"},{"name":"Keep-Alive","value":"timeout=5"},{"name":"cache-control","value":"no-cache, no-store, must-revalidate"},{"name":"content-length","value":"25397"},{"name":"content-type","value":"text/css; charset=UTF-8"},{"name":"etag","value":"W/\"2814749767327790-25397-2026-09-21T05:33:04.389Z\""},{"name":"last-modified","value":"Mon, 21 Sep 2026 05:33:04 GMT"}],"content":{"size":25397,"mimeType":"text/css; charset=UTF-8","compression":0,"text":"/* RIMIFY — components */\n\n/* ── buttons ─────────────────────────────────────────── */\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;height:48px;padding:0 24px;\n  border-radius:8px;font:700 14px/1 Lato,sans-serif;transition:background var(--e1),transform var(--e1),border-color var(--e1),color var(--e1)}\n.btn svg{flex:none}\n.btn-p{background:var(--blue);color:#fff}\n.btn-p:hover{background:var(--blue-h);transform:translateY(-1px);box-shadow:var(--sh-1);color:#fff;text-decoration:none}\n.btn-p:active{background:var(--blue-p);transform:translateY(0);box-shadow:none}\n.btn-s{background:#fff;border:1px solid var(--line);color:var(--ink)}\n.btn-s:hover{border-color:var(--blue);color:var(--blue);text-decoration:none}\n.btn-q{color:var(--blue);border:1px solid transparent;background:none}\n.btn-q:hover{border-color:var(--blue);text-decoration:none}\n.btn-full{width:100%}\n.btn-lg{height:52px;font-size:15px}\n.btn-xl{height:56px;font-size:16px}\n.btn:disabled,.btn[aria-disabled=true]{background:var(--line);color:var(--ink3);cursor:not-allowed;transform:none;box-shadow:none;border-color:transparent}\nbody.is-mobile .btn{height:52px}\n.link{display:inline-flex;align-items:center;gap:8px;font:700 14px/1 Lato,sans-serif;color:var(--blue)}\n.link:hover{text-decoration:none;color:var(--blue-h)}\n.spin{width:18px;height:18px;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;animation:sp .7s linear infinite}\n@keyframes sp{to{transform:rotate(360deg)}}\n\n/* ── surfaces ────────────────────────────────────────── */\n.card{background:#fff;border:1px solid var(--line);border-radius:14px}\n.card.raised{border-color:var(--line);box-shadow:var(--sh-1)}\n.card.lifted{box-shadow:var(--sh-2)}\n.card.pnl{border-radius:18px}\n.pad{padding:24px} .pad-l{padding:40px} .pad-s{padding:20px}\nbody.is-mobile .pad-l{padding:20px}\n.wash{background:var(--wash);border-radius:10px;padding:16px 18px}\n.hr{height:1px;background:var(--line);border:0;margin:0}\n.hr-s{height:1px;background:var(--line-s);border:0;margin:0}\n.hr-inset{height:1px;background:var(--line-s);margin:0 20px}\n\n/* ── inputs ──────────────────────────────────────────── */\n.field{width:100%;height:48px;border:0;border-radius:8px;background:var(--field);padding:0 16px;\n  font:400 15px/1 Lato,sans-serif;outline:none;transition:box-shadow var(--e1),background var(--e1)}\n.field:focus{background:#fff;box-shadow:0 0 0 1px var(--blue),0 0 0 4px var(--wash)}\n.field.err{background:#fff;box-shadow:0 0 0 1px var(--danger)}\n.field-mono{font:500 16px/1 \"IBM Plex Mono\",monospace;letter-spacing:.14em;text-transform:uppercase}\ntextarea.field{height:140px;padding:14px 16px;line-height:1.6;resize:vertical}\nselect.field{appearance:none;padding-right:40px;\n  background-image:url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' fill='none'><path d='M4 6.5l4 4 4-4' stroke='%237B8394' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/></svg>\");\n  background-repeat:no-repeat;background-position:right 14px center}\n.flabel{display:block;font:700 14px/1 Lato,sans-serif;margin-bottom:8px}\n.req{color:var(--danger)}\n.ferr{margin-top:6px;font:400 13px/1.4 Lato,sans-serif;color:var(--danger)}\n.ffield{position:relative}\n.ffield .ic{position:absolute;top:50%;transform:translateY(-50%);color:var(--ink3);pointer-events:none}\n.ffield .ic.l{left:14px} .ffield .ic.r{right:14px}\n.ffield .field.pl{padding-left:44px}\nbody.is-mobile .field{height:52px}\n.check{display:flex;align-items:flex-start;gap:10px;cursor:pointer;min-height:44px;padding:4px 0}\n.check input{width:20px;height:20px;accent-color:var(--blue);margin:2px 0 0;flex:none}\n\n/* ── chips & pills ───────────────────────────────────── */\n.chip{min-width:44px;height:44px;padding:0 12px;border-radius:999px;background:var(--ground);color:var(--ink2);\n  display:inline-flex;align-items:center;justify-content:center;\n  font:500 13px/1 \"IBM Plex Mono\",monospace;font-variant-numeric:tabular-nums;transition:background var(--e1),color var(--e1)}\n.chip:hover{background:var(--wash)}\n.chip[aria-pressed=true]{background:var(--blue);color:#fff}\n.chip[disabled]{opacity:.45;cursor:not-allowed;text-decoration:line-through;text-decoration-thickness:1px}\n.chip[disabled]:hover{background:var(--ground)}\n.chips{display:flex;flex-wrap:wrap;gap:8px}\n.pill{display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 10px;border-radius:999px;\n  font:700 11px/1 Lato,sans-serif;letter-spacing:.06em;text-transform:uppercase}\n.pill-ok{background:var(--ok-w);color:var(--ok)}\n.pill-warn{background:var(--warn-w);color:var(--warn)}\n.pill-danger{background:var(--danger-w);color:var(--danger)}\n.pill-blue{background:var(--blue);color:#fff}\n.pill-ink{background:var(--ground);color:var(--ink2)}\n.dot{width:8px;height:8px;border-radius:999px;flex:none}\n\n/* ── header ──────────────────────────────────────────── */\n.bluebar{background:var(--blue);color:#fff;min-height:40px;display:flex;align-items:center;justify-content:center;\n  gap:12px;font:400 13px/1.3 Lato,sans-serif;padding:8px 16px;text-align:center}\n.bluebar a{color:#fff;text-decoration:underline;text-underline-offset:3px}\n.hdr{background:#000;height:76px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0 40px;position:relative;z-index:40}\n.hdr .wordmark{color:#fff;justify-self:start}\n.hnav{display:flex;align-items:center;gap:36px}\n.hnav a{position:relative;font:700 14px/1 Lato,sans-serif;color:rgba(255,255,255,.88);padding:10px 0;display:flex;align-items:center;gap:8px}\n.hnav a::after{content:\"\";position:absolute;left:0;right:100%;bottom:0;height:2px;background:var(--blue);transition:right 160ms ease-out}\n.hnav a:hover{color:#fff;text-decoration:none}\n.hnav a:hover::after,.hnav a[aria-current=page]::after{right:0}\n.hcart{display:flex;flex-direction:column;align-items:center;gap:3px;color:#fff;position:relative}\n.hcart:hover{text-decoration:none}\n.hcart span{font:400 11px/1 Lato,sans-serif;color:rgba(255,255,255,.88)}\n.badge{position:absolute;top:-4px;right:2px;min-width:16px;height:16px;padding:0 4px;border-radius:999px;\n  background:var(--blue);color:#fff;font:700 10px/16px Lato,sans-serif;text-align:center}\n.hright{display:flex;justify-content:flex-end}\n.vbox{background:#fff;border-radius:8px;padding:10px 20px;text-align:center;cursor:pointer;position:relative}\n.vbox .l1{font:700 11px/1 Lato,sans-serif;color:var(--ink2)}\n.vbox .l2{font:700 13px/1.2 Lato,sans-serif;color:var(--ink);margin-top:3px;font-variant-numeric:tabular-nums}\n.vpop{position:absolute;top:calc(100% + 10px);left:50%;transform:translateX(-50%);width:260px;background:#fff;\n  border-radius:12px;box-shadow:var(--sh-2);padding:8px;text-align:left;z-index:50}\n.vpop button{display:block;width:100%;text-align:left;padding:12px;border-radius:8px;font:400 14px/1 Lato,sans-serif;min-height:44px}\n.vpop button:hover{background:var(--ground)}\nbody.is-mobile .hdr{height:60px;display:flex;justify-content:space-between;padding:0 16px}\nbody.is-mobile .hdr .wordmark{font-size:21px}\n.burger{width:44px;height:44px;display:flex;align-items:center;justify-content:center;color:#fff}\n\n/* ── footer ──────────────────────────────────────────── */\n.ftr{background:#000;color:#fff;padding:64px 0 28px}\n.ftr .cols{display:grid;grid-template-columns:1.5fr 1fr 1fr 1.4fr;gap:48px}\n.ftr p{color:rgba(255,255,255,.62);font:400 14px/1.7 Lato,sans-serif;max-width:300px}\n.ftr .micro{color:rgba(255,255,255,.45)}\n.ftr a{color:rgba(255,255,255,.78);font:400 14px/1 Lato,sans-serif}\n.ftr a:hover{color:#fff;text-decoration:none}\n.ftr .links{display:flex;flex-direction:column;gap:12px;margin-top:18px}\n.soc{display:flex;gap:18px;margin-top:24px}\n.soc a{color:#fff;opacity:.7;transition:opacity var(--e1)}\n.soc a:hover{opacity:1}\n.ftr .nl input{width:100%;height:48px;border:1px solid rgba(255,255,255,.18);border-radius:8px;\n  background:rgba(255,255,255,.06);padding:0 14px;color:#fff;outline:none;font:400 15px/1 Lato,sans-serif}\n.ftr .btm{border-top:1px solid rgba(255,255,255,.10);margin-top:48px;padding-top:20px;text-align:center;\n  font:400 13px/1 Lato,sans-serif;color:rgba(255,255,255,.45)}\nbody.is-mobile .ftr{padding:48px 0 24px}\nbody.is-mobile .ftr .cols{grid-template-columns:1fr}\nbody.is-mobile .ftr .cols .two{display:grid;grid-template-columns:1fr 1fr;gap:24px}\n\n/* ── bottom nav (mobile) ─────────────────────────────── */\n.bnav{position:fixed;left:0;right:0;bottom:0;background:#fff;border-top:1px solid var(--line);\n  padding:0 4px calc(8px + env(safe-area-inset-bottom));display:grid;grid-template-columns:repeat(5,1fr);\n  align-items:end;z-index:60}\n.bnav button{height:58px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:6px;\n  padding-bottom:2px;color:var(--ink3);position:relative}\n.bnav button span{font:700 10px/1 Lato,sans-serif;white-space:nowrap}\n.bnav button[aria-current=page]{color:var(--blue)}\n.bnav .mid{position:relative;height:58px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;color:var(--ink3)}\n.bnav .mid .fab{position:absolute;top:-16px;left:50%;transform:translateX(-50%);width:52px;height:52px;\n  border-radius:999px;background:var(--blue);color:#fff;display:flex;align-items:center;justify-content:center;\n  box-shadow:0 0 0 5px #fff,0 8px 20px -8px rgba(26,68,212,.65)}\n.bnav .mid span{font:700 10px/1 Lato,sans-serif;letter-spacing:-.01em;white-space:nowrap;padding-bottom:2px}\nbody.is-mobile main{padding-bottom:96px}\n\n/* ── product card ────────────────────────────────────── */\n.well{position:relative;aspect-ratio:1/1;border-radius:10px;background:linear-gradient(#FFFFFF,#FAFBFE);overflow:hidden}\n.well .art{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;transition:transform 240ms cubic-bezier(.2,.8,.2,1)}\n.well .stock{position:absolute;top:12px;right:12px}\n.pcard{background:#fff;border:1px solid var(--line);border-radius:14px;padding:20px;display:flex;flex-direction:column;\n  box-shadow:var(--sh-1);transition:box-shadow var(--e2)}\n.pcard:hover{box-shadow:var(--sh-2)}\n.pcard:hover .well .art{transform:scale(1.04)}\n.pcard .brand{margin-top:16px}\n.pcard .model{font:700 18px/1.2 Lato,sans-serif;letter-spacing:-.01em;margin-top:8px}\n.pcard .fin{font:400 14px/1.4 Lato,sans-serif;color:var(--ink2);margin-top:4px}\n.pcard .rate{display:flex;align-items:center;gap:6px;margin-top:8px;font-variant-numeric:tabular-nums}\n.pcard .star{color:var(--star);font-size:14px;line-height:1}\n.pcard .price{font:700 22px/1 Lato,sans-serif;font-variant-numeric:tabular-nums;margin-top:6px}\n.pcard .fit{display:flex;align-items:center;gap:8px;padding:10px 12px;border-radius:8px;font:700 13px/1.35 Lato,sans-serif}\n.fit-ok{background:var(--wash);color:var(--blue)}\n.fit-warn{background:var(--warn-w);color:var(--warn)}\n.fit-no{background:var(--danger-w);color:var(--danger)}\n.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}\n.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}\n.grid2{display:grid;grid-template-columns:1fr 1fr;gap:24px}\nbody.is-mobile .grid4,body.is-mobile .grid3,body.is-mobile .grid2{grid-template-columns:1fr;gap:16px}\n.rail{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 16px 8px;margin:0 -16px}\n.rail>*{flex:none;scroll-snap-align:start}\n\n/* ── accordion ───────────────────────────────────────── */\n.acc{background:#fff;border:1px solid var(--line);border-radius:10px;overflow:hidden}\n.acc.open{border-color:var(--blue)}\n.acc>button{width:100%;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px;\n  min-height:56px;text-align:left;font:700 15px/1.4 Lato,sans-serif;transition:background var(--e1)}\n.acc.open>button{background:var(--wash)}\n.acc>button svg{flex:none;color:var(--ink3);transition:transform var(--e2)}\n.acc.open>button svg{transform:rotate(180deg);color:var(--blue)}\n.acc .body{display:grid;grid-template-rows:0fr;transition:grid-template-rows var(--e2)}\n.acc.open .body{grid-template-rows:1fr}\n.acc .body>div{overflow:hidden}\n.acc .body p{padding:0 18px 18px;font:400 15px/1.7 Lato,sans-serif;color:var(--ink2)}\n.acc mark{background:var(--wash);color:inherit}\n.accs{display:flex;flex-direction:column;gap:12px}\n\n/* ── filter bar / segmented ──────────────────────────── */\n.fbar{background:#fff;border:1px solid var(--line);border-radius:12px;padding:8px;display:flex;align-items:center;flex-wrap:wrap}\n.fbar .sep{width:1px;align-self:stretch;margin:10px 4px;background:var(--line)}\n.fpill{display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 14px;border-radius:8px;\n  font:700 14px/1 Lato,sans-serif;transition:background var(--e1),color var(--e1)}\n.fpill:hover{background:var(--ground)}\n.fpill[aria-expanded=true]{background:var(--wash);color:var(--blue)}\n.fpill .cnt{background:var(--blue);color:#fff;border-radius:999px;padding:1px 7px;font:700 11px/1.5 Lato,sans-serif}\n.toggle{display:inline-flex;align-items:center;gap:10px;height:40px;padding:0 14px;border-radius:999px;\n  background:var(--ground);font:700 14px/1 Lato,sans-serif;color:var(--ink2)}\n.toggle[aria-pressed=true]{background:var(--blue);color:#fff}\n.fdrop{position:absolute;top:calc(100% + 8px);left:0;min-width:260px;background:#fff;border-radius:12px;\n  box-shadow:var(--sh-2);padding:8px;z-index:30;max-height:340px;overflow:auto}\n.fdrop label{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:8px;min-height:44px;cursor:pointer}\n.fdrop label:hover{background:var(--ground)}\n.fdrop label.off{opacity:.4;cursor:not-allowed}\n.fdrop .n{margin-left:auto;font:500 12px/1 \"IBM Plex Mono\",monospace;color:var(--ink3)}\n.seg{display:inline-flex;background:var(--ground);border-radius:999px;padding:4px;gap:4px}\n.seg button{height:40px;padding:0 18px;border-radius:999px;font:700 14px/1 Lato,sans-serif;color:var(--ink2)}\n.seg button[aria-pressed=true]{background:#fff;color:var(--ink);box-shadow:var(--sh-1)}\n\n/* ── tables ──────────────────────────────────────────── */\n.tbl{width:100%;border-collapse:collapse}\n.tbl th{text-align:left;padding:0 0 14px;font:700 11px/1 Lato,sans-serif;letter-spacing:.10em;text-transform:uppercase;color:var(--ink3)}\n.tbl td{padding:16px 0;border-top:1px solid var(--line-s);vertical-align:middle}\n.tbl .r{text-align:right;font-variant-numeric:tabular-nums}\n.tbl tbody tr:hover{background:var(--ground)}\n.step{display:inline-flex;align-items:center;height:44px;border:1px solid var(--line);border-radius:8px;overflow:hidden}\n.step button{width:40px;height:44px;display:flex;align-items:center;justify-content:center;color:var(--ink2)}\n.step button:hover{background:var(--ground)}\n.step input{width:46px;height:44px;border:0;text-align:center;background:none;font:700 15px/1 Lato,sans-serif;\n  font-variant-numeric:tabular-nums;outline:none}\n\n/* ── tiles / selection ───────────────────────────────── */\n.tile{background:#fff;border:1px solid var(--line);border-radius:10px;padding:12px;cursor:pointer;\n  transition:border-color var(--e1),background var(--e1);position:relative;text-align:left}\n.tile[aria-pressed=true]{border:2px solid var(--blue);background:var(--wash);padding:11px}\n.tile .tick{position:absolute;top:8px;right:8px;opacity:0;color:var(--blue)}\n.tile[aria-pressed=true] .tick{opacity:1}\n.mtile{aspect-ratio:1/1;background:#fff;border:1px solid var(--line);border-radius:14px;display:flex;\n  flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:0 10px;\n  transition:border-color var(--e1),transform var(--e1)}\n.mtile:hover{border-color:var(--blue);transform:translateY(-2px)}\n.mtile-l{display:flex;align-items:center;justify-content:center;height:38px;opacity:.76;transition:opacity var(--e1)}\n.mtile:hover .mtile-l{opacity:1}\n.mtile-n{font:700 11px/1 Lato,sans-serif;letter-spacing:.1em;color:var(--ink2);text-align:center;transition:color var(--e1)}\n.mtile:hover .mtile-n{color:var(--ink)}\nbody.is-mobile .mtile{gap:9px;border-radius:12px}\nbody.is-mobile .mtile-l{height:28px}\nbody.is-mobile .mtile-n{font-size:9px;letter-spacing:.08em}\n\n/* ── sheets, modals, toasts ──────────────────────────── */\n.scrim{position:fixed;inset:0;background:rgba(6,8,12,.55);z-index:70;opacity:0;pointer-events:none;transition:opacity var(--e3)}\n.scrim.on{opacity:1;pointer-events:auto}\n.sheet{position:fixed;left:0;right:0;bottom:0;max-height:92vh;background:#fff;border-radius:18px 18px 0 0;z-index:80;\n  transform:translateY(100%);transition:transform var(--e3);display:flex;flex-direction:column}\n.sheet.on{transform:none}\n.sheet header{padding:16px 16px 12px;border-bottom:1px solid var(--line-s);display:flex;align-items:center;justify-content:space-between}\n.sheet .sbody{overflow:auto;padding:16px;flex:1}\n.sheet footer{padding:12px 16px calc(12px + env(safe-area-inset-bottom));border-top:1px solid var(--line-s)}\n.modal{position:fixed;top:50%;left:50%;transform:translate(-50%,-48%);width:min(560px,92vw);background:#fff;\n  border-radius:18px;box-shadow:var(--sh-2);z-index:80;opacity:0;pointer-events:none;transition:opacity var(--e3),transform var(--e3)}\n.modal.on{opacity:1;pointer-events:auto;transform:translate(-50%,-50%)}\n.toast{position:fixed;left:50%;bottom:28px;transform:translate(-50%,16px);background:var(--ink);color:#fff;\n  padding:14px 20px;border-radius:10px;font:700 14px/1 Lato,sans-serif;z-index:90;opacity:0;pointer-events:none;\n  transition:opacity var(--e2),transform var(--e2);display:flex;align-items:center;gap:10px}\n.toast.on{opacity:1;transform:translate(-50%,0)}\nbody.is-mobile .toast{bottom:104px}\n\n/* ── misc ────────────────────────────────────────────── */\n.crumb{font:400 13px/1 Lato,sans-serif;color:var(--ink3);display:flex;gap:8px;align-items:center}\n.qmark{width:22px;height:22px;border-radius:999px;background:var(--wash);color:var(--blue);\n  font:700 12px/1 Lato,sans-serif;display:inline-flex;align-items:center;justify-content:center;flex:none}\n.qmark:hover{background:var(--bline)}\n\n/* ── mobile hit targets: nothing interactive under 44px ── */\nbody.is-mobile .qmark{width:44px;height:44px;font-size:15px}\nbody.is-mobile .ftr .links a{display:flex;align-items:center;min-height:44px}\nbody.is-mobile .ftr .soc a{width:44px;height:44px;display:inline-flex;align-items:center;justify-content:center}\nbody.is-mobile .bluebar{min-height:48px;padding-block:0}\nbody.is-mobile .bluebar a{display:inline-flex;align-items:center;min-height:44px;padding-inline:4px}\nbody.is-mobile .seg button{height:44px}\nbody.is-mobile .link{min-height:44px}\nbody.is-mobile .crumb a{display:inline-flex;align-items:center;min-height:44px}\nbody.is-mobile .hdr .wordmark,body.is-mobile .ftr .wordmark{display:inline-flex;align-items:center;min-height:44px}\nbody.is-mobile .legal a,body.is-mobile .ftr .btm a{display:inline-flex;align-items:center;min-height:44px}\nbody.is-mobile .pcard .model a{display:flex;align-items:center;min-height:44px}\nbody.is-mobile .chip{min-height:44px}\nbody.is-mobile .rev-link{display:inline-flex;align-items:center;min-height:44px}\nbody.is-mobile .check input{width:24px;height:24px}\nbody.is-mobile .check a{padding:8px 2px;margin:-8px -2px}\nbody.is-mobile .tap{display:inline-flex;align-items:center;min-height:44px}\n.crumb a{color:var(--ink3);text-decoration:underline;text-underline-offset:2px}\n.skel{background:linear-gradient(90deg,#EEF0F5,#F7F8FD,#EEF0F5);background-size:200% 100%;animation:sh 1.2s linear infinite;border-radius:6px}\n@keyframes sh{to{background-position:-200% 0}}\n.pager{display:flex;justify-content:center;gap:8px;margin-top:48px}\n.pager button{min-width:44px;height:44px;border-radius:8px;font:700 14px/1 Lato,sans-serif;color:var(--ink2)}\n.pager button:hover{background:var(--wash)}\n.pager button[aria-current=page]{background:var(--blue);color:#fff}\n.stepbar{display:flex;align-items:center;gap:12px}\n.stepbar .s{display:flex;align-items:center;gap:8px;font:700 13px/1 Lato,sans-serif;color:var(--ink3)}\n.stepbar .s.cur{color:var(--blue)}\n.stepbar .s.done{color:var(--ink2)}\n.stepbar .bar{width:40px;height:1px;background:var(--line)}\n.deflist{display:grid;grid-template-columns:auto 1fr;gap:0}\n.deflist dt{font:400 13px/1 Lato,sans-serif;color:var(--ink3);padding:12px 0;border-top:1px solid var(--line-s)}\n.deflist dd{margin:0;padding:12px 0;border-top:1px solid var(--line-s);text-align:right;\n  font:500 14px/1 \"IBM Plex Mono\",monospace;font-variant-numeric:tabular-nums}\n.deflist dt:first-of-type,.deflist dd:first-of-type{border-top:0}\n.sticky-bar{position:fixed;left:0;right:0;bottom:calc(72px + env(safe-area-inset-bottom));background:#fff;\n  border-top:1px solid var(--line);box-shadow:var(--sh-2);padding:10px 16px;display:flex;align-items:center;\n  justify-content:space-between;gap:12px;z-index:55;transform:translateY(120%);transition:transform var(--e3)}\n.sticky-bar.on{transform:none}\n\n/* ── admin shell ─────────────────────────────────────── */\n.adm{display:grid;grid-template-columns:248px 1fr;min-height:100vh;background:var(--ground)}\n.adm-side{background:var(--surface);border-right:1px solid var(--line);position:sticky;top:0;height:100vh;overflow:auto;\n  scrollbar-width:thin;scrollbar-color:var(--line) transparent}\n.adm-side::-webkit-scrollbar{width:8px}\n.adm-side::-webkit-scrollbar-thumb{background:var(--line);border-radius:999px;border:2px solid var(--surface)}\n.adm-side::-webkit-scrollbar-track{background:transparent}\n.adm-nav{display:flex;align-items:center;gap:10px;padding:0 16px;min-height:44px;\n  font:400 14px/1.3 Lato,sans-serif;color:var(--ink2);text-decoration:none;transition:color .12s ease-out,background .12s ease-out}\n.adm-nav-i{display:flex;width:20px;height:20px;flex:none;color:var(--ink3);transition:color .12s ease-out}\n.adm-nav-i svg{width:20px;height:20px}\n.adm-nav:hover{background:var(--band);color:var(--ink)}\n.adm-nav:hover .adm-nav-i{color:var(--ink2)}\n.adm-nav.on{background:var(--wash);color:var(--blue);font-weight:700;box-shadow:inset 2px 0 0 var(--blue)}\n.adm-nav.on .adm-nav-i{color:var(--blue)}\n.adm-main{min-width:0}\n.adm-top{height:60px;background:var(--surface);border-bottom:1px solid var(--line);display:flex;align-items:center;\n  justify-content:space-between;padding:0 24px;position:sticky;top:0;z-index:20;gap:12px}\n.adm-rail{display:none}\nbody.is-mobile .adm-rail{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding:10px 12px;\n  background:var(--surface);border-bottom:1px solid var(--line);position:sticky;top:60px;z-index:19}\nbody.is-mobile .adm-rail::-webkit-scrollbar{display:none}\n.adm-rail-i{flex:none;display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 14px;border-radius:999px;\n  background:var(--band);color:var(--ink2);font:700 13px/1 Lato,sans-serif;text-decoration:none;white-space:nowrap}\n.adm-rail-i.on{background:var(--wash);color:var(--blue)}\nbody.is-mobile .adm-top{gap:8px}\nbody.is-mobile .adm-top .crumb,body.is-mobile .adm-env,body.is-mobile .adm-user{display:none}\nbody.is-mobile .adm-top .ffield{margin:0;min-width:0;flex:1}\n.adm-body{padding:32px}\nbody.is-mobile .adm{grid-template-columns:1fr}\nbody.is-mobile .adm-side{display:none}\nbody.is-mobile .adm-body{padding:16px}\nbody.is-mobile .adm-top{padding:0 12px}\n.split{display:grid;grid-template-columns:46fr 54fr;min-height:100vh}\n.split .brandp{background:#0B0D11;color:#fff;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:space-between;padding:40px}\n.split .brandp .bp{position:absolute;inset:0;pointer-events:none}\n.split .brandp > *:not(.bp){position:relative;z-index:1}\n.split .formp{background:var(--surface);display:flex;align-items:center;justify-content:center;padding:40px}\n.split .formp > div{width:100%;max-width:380px}\nbody.is-mobile .split{grid-template-columns:1fr;min-height:auto}\nbody.is-mobile .split .brandp{height:230px;padding:20px}\nbody.is-mobile .split .formp{padding:24px 16px}\n.otp.err{box-shadow:0 0 0 1px var(--danger)}\n\nbody.dark{--surface:#12151C;--ground:#0B0D11;--band:#0F131A;--ink:#EDEFF3;--ink2:#A6AEBD;--ink3:#79818F;\n  --line:#232834;--line-s:#1C212B;--field:#1A1F28;--row:#1A1F28;--blue:#7C97FF;--wash:#1A2138;--bline:#2B3654}\nbody.dark .adm-side,body.dark .adm-top{background:#0B0D11}\nbody.dark .tbl tbody tr:hover{background:#151922}\n\n"},"headersSize":344,"bodySize":25397,"redirectURL":"","_transferSize":25741},"cache":{},"timings":{"dns":0.01,"connect":0.708,"ssl":2.929,"send":0,"wait":2.909,"receive":7.653},"_frameref":"frame@0ae505f1a732736d1625028bc55564cb","_monotonicTime":69762.065,"_resourceType":"stylesheet","serverIPAddress":"127.0.0.1","_serverPort":5500,"_securityDetails":{}},{"pageref":"page@76b9a45bb084a7125d884186b129a128","startedDateTime":"2026-09-21T08:29:45.903Z","time":17.285,"request":{"method":"GET","url":"http://127.0.0.1:5500/shared/data.js","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Language","value":"de-DE"},{"name":"Referer","value":"http://127.0.0.1:5500/mobile/rimify-check.html"},{"name":"User-Agent","value":"Mozilla/5.0 (Linux; Android 14; Pixel 7) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Mobile Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\""},{"name":"sec-ch-ua-mobile","value":"?1"},{"name":"sec-ch-ua-platform","value":"\"Android\""}],"queryString":[],"headersSize":386,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept-Ranges","value":"bytes"},{"name":"Connection","value":"keep-alive"},{"name":"Date","value":"Mon, 21 Sep 2026 08:29:45 GMT"},{"name":"Keep-Alive","value":"timeout=5"},{"name":"cache-control","value":"no-cache, no-store, must-revalidate"},{"name":"content-length","value":"18613"},{"name":"content-type","value":"application/javascript; charset=UTF-8"},{"name":"etag","value":"W/\"3096224744047795-18613-2026-09-21T05:34:29.578Z\""},{"name":"last-modified","value":"Mon, 21 Sep 2026 05:34:29 GMT"}],"content":{"size":18613,"mimeType":"application/javascript; charset=UTF-8","compression":0,"text":"/* RIMIFY — seed data */\n(function (w) {\n  'use strict';\n\n  var eur = function (n) {\n    return n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';\n  };\n  var dec = function (n, d) {\n    return n.toLocaleString('de-DE', { minimumFractionDigits: d || 0, maximumFractionDigits: d || 0 });\n  };\n\n  /* ── 12 wheels ─────────────────────────────────────── */\n  var wheels = [\n    { sku:'BOR-HAV-GRM', brand:'BORBET', model:'Havanna', finish:'graphite', finishName:'Graphite matt',\n      spokes:20, design:'Mehrspeichen', sizes:[17,18,19,20], widths:[7.5,8,8.5,9], et:35, price:750.29,\n      rating:4.8, reviews:555, stock:'in', verdict:'ok', conditions:[], sale:false, blocked:[] },\n    { sku:'OZ-STG-SIL', brand:'OZ RACING', model:'Superturismo GT', finish:'silver', finishName:'Matt Race Silver',\n      spokes:10, design:'Y-Speiche', sizes:[17,18,19], widths:[7.5,8,8.5], et:40, price:689.00,\n      rating:4.7, reviews:312, stock:'in', verdict:'ok', conditions:[], sale:true, blocked:[17] },\n    { sku:'ALU-MON-BLK', brand:'ALUTEC', model:'Monstr', finish:'black', finishName:'Racing Schwarz',\n      spokes:5, design:'Fünfspeiche', sizes:[18,19,20], widths:[8,8.5,9], et:45, price:812.40,\n      rating:4.6, reviews:198, stock:'in', verdict:'conditional', sale:false, blocked:[],\n      conditions:['Eintragung in die Fahrzeugpapiere erforderlich.','Nur mit den angegebenen Radschrauben zulässig.'] },\n    { sku:'BBS-CIR-PLA', brand:'BBS', model:'CI-R', finish:'polished', finishName:'Platinum Silber',\n      spokes:10, design:'Kreuzspeiche', sizes:[18,19,20], widths:[8,8.5,9.5], et:32, price:1196.00,\n      rating:4.9, reviews:87, stock:'out', verdict:'ok', conditions:[], sale:false, blocked:[20] },\n    { sku:'YID-GRP-BRZ', brand:'YIDO', model:'Grip', finish:'bronze', finishName:'Bronze matt',\n      spokes:7, design:'Fünfspeiche', sizes:[18,19], widths:[8,8.5], et:38, price:729.50,\n      rating:4.4, reviews:141, stock:'in', verdict:'ok', conditions:[], sale:false, blocked:[] },\n    { sku:'ROT-KPS-BLK', brand:'rotiform', model:'KPS', finish:'black', finishName:'Tiefschwarz glänzend',\n      spokes:5, design:'Fünfspeiche', sizes:[17,18,19], widths:[7.5,8,8.5], et:30, price:865.00,\n      rating:4.5, reviews:203, stock:'in', verdict:'conditional', sale:false, blocked:[],\n      conditions:['Bördeln der Radläufe erforderlich.','Eintragung in die Fahrzeugpapiere erforderlich.'] },\n    { sku:'BOR-HAV-SIL', brand:'BORBET', model:'Havanna', finish:'silver', finishName:'Brillantsilber',\n      spokes:20, design:'Mehrspeichen', sizes:[17,18,19], widths:[7.5,8,8.5], et:35, price:718.90,\n      rating:4.7, reviews:412, stock:'in', verdict:'ok', conditions:[], sale:true, blocked:[] },\n    { sku:'OZ-STG-BLK', brand:'OZ RACING', model:'Superturismo GT', finish:'black', finishName:'Matt Black',\n      spokes:10, design:'Y-Speiche', sizes:[18,19,20], widths:[8,8.5,9], et:42, price:934.00,\n      rating:4.8, reviews:266, stock:'in', verdict:'ok', conditions:[], sale:false, blocked:[] },\n    { sku:'ALU-MON-GRM', brand:'ALUTEC', model:'Monstr', finish:'graphite', finishName:'Graphit poliert',\n      spokes:5, design:'Fünfspeiche', sizes:[19,20], widths:[8.5,9], et:45, price:889.00,\n      rating:4.2, reviews:64, stock:'out', verdict:'ok', conditions:[], sale:false, blocked:[] },\n    { sku:'BBS-CIR-BRZ', brand:'BBS', model:'CI-R', finish:'bronze', finishName:'Satin Bronze',\n      spokes:10, design:'Kreuzspeiche', sizes:[18,19,20], widths:[8,8.5,9.5], et:32, price:1149.00,\n      rating:4.9, reviews:118, stock:'in', verdict:'conditional', sale:false, blocked:[],\n      conditions:['Verwendung von Schneeketten nicht zulässig.'] },\n    { sku:'YID-GRP-POL', brand:'YIDO', model:'Grip', finish:'polished', finishName:'Hochglanz poliert',\n      spokes:7, design:'Fünfspeiche', sizes:[17,18,19,20], widths:[7.5,8,8.5,9], et:38, price:798.00,\n      rating:4.3, reviews:95, stock:'in', verdict:'ok', conditions:[], sale:false, blocked:[17] },\n    { sku:'ROT-KPS-GRM', brand:'rotiform', model:'KPS', finish:'graphite', finishName:'Anthrazit matt',\n      spokes:5, design:'Fünfspeiche', sizes:[18,19,20], widths:[8,8.5,9], et:30, price:902.50,\n      rating:4.6, reviews:177, stock:'in', verdict:'ok', conditions:[], sale:true, blocked:[] }\n  ];\n\n  /* ── tyres ─────────────────────────────────────────── */\n  var tyres = [\n    { brand:'NEXEN TIRES', model:'N Fera Sport', season:'Sommerreifen', size:'245/45 R18 92Y', price:1599.15, rating:5, reviews:15, best:true },\n    { brand:'NEXEN TIRES', model:'N Blue 4Season', season:'Ganzjahresreifen', size:'245/45 R18 92Y', price:1489.00, rating:5, reviews:15, best:false },\n    { brand:'BRIDGESTONE', model:'Potenza Sport', season:'Sommerreifen', size:'245/45 R18 96Y', price:1812.40, rating:5, reviews:42, best:false },\n    { brand:'CONTINENTAL', model:'PremiumContact 7', season:'Sommerreifen', size:'245/45 R18 92Y', price:1725.00, rating:5, reviews:88, best:false },\n    { brand:'MICHELIN', model:'Pilot Sport 5', season:'Sommerreifen', size:'245/45 R18 96Y', price:1968.00, rating:5, reviews:61, best:false },\n    { brand:'BRIDGESTONE', model:'Blizzak LM005', season:'Winterreifen', size:'225/35 R18 87V', price:1394.00, rating:4, reviews:27, best:false }\n  ];\n\n  /* ── makes → models → variants ─────────────────────── */\n  var makes = [\n    { name:'BMW', models:[\n      { name:'3er Coupe', variants:[\n        { name:'320i Coupe', years:'1997–1999', kw:110, ps:150, body:'Coupé', vmax:216, hsn:'0005', tsn:'582' },\n        { name:'328i Coupe', years:'1997–2000', kw:142, ps:193, body:'Coupé', vmax:240, hsn:'0005', tsn:'583' } ] },\n      { name:'M4', variants:[\n        { name:'M4 Competition F82', years:'2016–2020', kw:331, ps:450, body:'Coupé', vmax:290, hsn:'0005', tsn:'CJH' },\n        { name:'M4 F82', years:'2014–2016', kw:317, ps:431, body:'Coupé', vmax:250, hsn:'0005', tsn:'CJG' } ] },\n      { name:'Z8', variants:[\n        { name:'Z8 4.9 E52', years:'1999–2003', kw:294, ps:400, body:'Roadster', vmax:250, hsn:'0005', tsn:'674' } ] },\n      { name:'5er Touring', variants:[\n        { name:'530d Touring G31', years:'2017–2020', kw:195, ps:265, body:'Kombi', vmax:250, hsn:'0005', tsn:'BPH' } ] } ] },\n    { name:'Audi', models:[\n      { name:'RS 4 Avant', variants:[\n        { name:'RS 4 Avant Quattro B9', years:'03/2018–11/2019', kw:331, ps:450, body:'Kombi', vmax:280, hsn:'1860', tsn:'AAS', vsn:'00001' },\n        { name:'RS 4 Avant Quattro B9 FL', years:'12/2019–heute', kw:331, ps:450, body:'Kombi', vmax:290, hsn:'1860', tsn:'AAS', vsn:'00017' },\n        { name:'RS4 2.7 Avant B5', years:'2000–2001', kw:279, ps:380, body:'Kombi', vmax:250, hsn:'7967', tsn:'307' } ] },\n      { name:'A3 Sportback', variants:[\n        { name:'A3 Sportback 35 TFSI', years:'2020–heute', kw:110, ps:150, body:'Schrägheck', vmax:224, hsn:'0588', tsn:'AAH' } ] },\n      { name:'Q5', variants:[\n        { name:'Q5 40 TDI quattro', years:'2019–heute', kw:150, ps:204, body:'SUV', vmax:222, hsn:'0588', tsn:'BLQ' } ] } ] },\n    { name:'Mercedes-Benz', models:[\n      { name:'C-Klasse', variants:[\n        { name:'C 220 d W205', years:'2018–2021', kw:143, ps:194, body:'Limousine', vmax:245, hsn:'1313', tsn:'HGX' },\n        { name:'C 300 W206', years:'2021–heute', kw:190, ps:258, body:'Limousine', vmax:250, hsn:'1313', tsn:'KTA' } ] },\n      { name:'A-Klasse', variants:[\n        { name:'A 200 W177', years:'2018–heute', kw:120, ps:163, body:'Schrägheck', vmax:225, hsn:'1313', tsn:'HPN' } ] },\n      { name:'GLC', variants:[\n        { name:'GLC 300 d 4MATIC', years:'2019–2022', kw:180, ps:245, body:'SUV', vmax:238, hsn:'1313', tsn:'JBB' } ] } ] },\n    { name:'Volkswagen', models:[\n      { name:'Golf', variants:[\n        { name:'Golf VIII 1.5 TSI', years:'2020–heute', kw:110, ps:150, body:'Schrägheck', vmax:224, hsn:'0603', tsn:'CKF' },\n        { name:'Golf VII GTI', years:'2013–2020', kw:169, ps:230, body:'Schrägheck', vmax:250, hsn:'0603', tsn:'BGV' } ] },\n      { name:'Passat Variant', variants:[\n        { name:'Passat Variant 2.0 TDI B8', years:'2019–2023', kw:110, ps:150, body:'Kombi', vmax:216, hsn:'0603', tsn:'BZK' } ] },\n      { name:'Fox', variants:[\n        { name:'Fox 1.2 5Z', years:'2005–2011', kw:40, ps:55, body:'Schrägheck', vmax:148, hsn:'0603', tsn:'AAT' } ] } ] },\n    { name:'Porsche', models:[\n      { name:'911', variants:[\n        { name:'911 Carrera 992', years:'2019–heute', kw:283, ps:385, body:'Coupé', vmax:293, hsn:'0583', tsn:'AKQ' } ] },\n      { name:'Macan', variants:[\n        { name:'Macan S', years:'2019–heute', kw:260, ps:354, body:'SUV', vmax:259, hsn:'0583', tsn:'ADH' } ] },\n      { name:'928', variants:[\n        { name:'928 4.5', years:'1977–1982', kw:177, ps:240, body:'Coupé', vmax:230, hsn:'0583', tsn:'344' } ] } ] },\n    { name:'Opel', models:[\n      { name:'Astra', variants:[\n        { name:'Astra L 1.2 Turbo', years:'2022–heute', kw:96, ps:130, body:'Schrägheck', vmax:210, hsn:'1844', tsn:'BAT' } ] },\n      { name:'Insignia', variants:[\n        { name:'Insignia Sports Tourer 2.0', years:'2017–2022', kw:147, ps:200, body:'Kombi', vmax:235, hsn:'1844', tsn:'AGR' } ] },\n      { name:'Corsa', variants:[\n        { name:'Corsa F 1.2', years:'2019–heute', kw:55, ps:75, body:'Schrägheck', vmax:174, hsn:'1844', tsn:'AZP' } ] } ] },\n    { name:'Ford', models:[\n      { name:'Focus', variants:[\n        { name:'Focus ST Mk4', years:'2019–heute', kw:206, ps:280, body:'Schrägheck', vmax:250, hsn:'8566', tsn:'BQK' } ] },\n      { name:'Kuga', variants:[\n        { name:'Kuga 2.5 PHEV', years:'2020–heute', kw:165, ps:225, body:'SUV', vmax:200, hsn:'8566', tsn:'BRD' } ] },\n      { name:'Mustang', variants:[\n        { name:'Mustang GT 5.0', years:'2018–2023', kw:331, ps:450, body:'Coupé', vmax:250, hsn:'8566', tsn:'AXP' } ] } ] },\n    { name:'Škoda', models:[\n      { name:'Octavia', variants:[\n        { name:'Octavia Combi 2.0 TDI', years:'2020–heute', kw:110, ps:150, body:'Kombi', vmax:224, hsn:'8004', tsn:'BAH' } ] },\n      { name:'Superb', variants:[\n        { name:'Superb Combi 2.0 TSI 4x4', years:'2019–2023', kw:200, ps:272, body:'Kombi', vmax:250, hsn:'8004', tsn:'AQM' } ] },\n      { name:'Kodiaq', variants:[\n        { name:'Kodiaq 2.0 TDI 4x4', years:'2021–heute', kw:147, ps:200, body:'SUV', vmax:215, hsn:'8004', tsn:'BDF' } ] } ] }\n  ];\n\n  /* ── HSN/TSN lookup ────────────────────────────────── */\n  var keyIndex = [];\n  makes.forEach(function (mk) {\n    mk.models.forEach(function (md) {\n      md.variants.forEach(function (v) {\n        if (!v.hsn) return;\n        keyIndex.push({\n          id: (v.hsn + '-' + v.tsn + '-' + (v.vsn || md.name)).replace(/\\s+/g, ''),\n          make: mk.name, model: md.name, variant: v.name,\n          label: mk.name + ' ' + md.name + ' ' + v.name.replace(mk.name + ' ', ''),\n          short: mk.name + ' ' + md.name,\n          hsn: v.hsn, tsn: v.tsn, vsn: v.vsn || null,\n          years: v.years, kw: v.kw, ps: v.ps, body: v.body, vmax: v.vmax\n        });\n      });\n    });\n  });\n\n  function lookup(hsn, tsn) {\n    var h = String(hsn || '').trim().toUpperCase();\n    var t = String(tsn || '').trim().toUpperCase();\n    return keyIndex.filter(function (v) { return v.hsn === h && v.tsn === t; });\n  }\n\n  /* ── FAQ ───────────────────────────────────────────── */\n  var faq = [\n    { g:'KOMPATIBILITÄT & FREIGABE', q:'Was ist RIMIFY?',\n      a:'RIMIFY ist ein Felgenshop für den deutschen Markt. Du gibst dein Fahrzeug an, wir zeigen dir ausschließlich Felgen, die für genau dieses Fahrzeug eine gültige Freigabe haben. Reifen und fertig montierte Kompletträder bekommst du auf Wunsch dazu.' },\n    { g:'KOMPATIBILITÄT & FREIGABE', q:'Woher weiß ich, ob eine Felge zu meinem Auto passt?',\n      a:'Sobald du dein Fahrzeug gewählt hast, prüfen wir jede Felge gegen das zugehörige Gutachten – Felgenbreite, Einpresstiefe, zulässige Reifengrößen und Auflagen. Was dir angezeigt wird, ist freigegeben. Einzelne Kombinationen kannst du jederzeit über RIMIFY-CHECK nachprüfen.' },\n    { g:'KOMPATIBILITÄT & FREIGABE', q:'Was bedeutet „Eintragung erforderlich“?',\n      a:'Bei manchen Felgen verlangt das Gutachten, dass die Änderung von einer amtlich anerkannten Prüfstelle abgenommen und in die Fahrzeugpapiere eingetragen wird. Wir weisen darauf hin, bevor du die Felge in den Warenkorb legst – und du kannst gezielt nach Felgen ohne Eintragungspflicht filtern.' },\n    { g:'KOMPATIBILITÄT & FREIGABE', q:'Wo finde ich HSN und TSN in meinen Fahrzeugpapieren?',\n      a:'In der Zulassungsbescheinigung Teil I stehen sie in den Feldern 2.1 (HSN, vierstellig) und 2.2 (TSN, dreistellig). Im älteren Fahrzeugschein stehen dieselben Nummern an anderer Stelle – beide Varianten zeigen wir dir in der Fahrzeugauswahl.' },\n    { g:'KOMPATIBILITÄT & FREIGABE', q:'Was ist, wenn zu meiner Schlüsselnummer mehrere Fahrzeuge angezeigt werden?',\n      a:'Das ist normal. Eine Kombination aus HSN und TSN kann mehrere Varianten umfassen, die sich in Bauzeitraum, Leistung oder Achslast unterscheiden. Wir fragen dann kurz nach, weil genau diese Unterschiede darüber entscheiden, welche Reifen zulässig sind.' },\n    { g:'BESTELLUNG & VERSAND', q:'Was ist ein Komplettrad und was ist enthalten?',\n      a:'Ein Komplettrad ist eine Felge mit bereits aufgezogenem und gewuchtetem Reifen. Enthalten sind Montage, Wuchten, Ventile, Anbauset und ABE. Du musst die Räder nur noch anschrauben.' },\n    { g:'BESTELLUNG & VERSAND', q:'Wie lange dauert die Lieferung?',\n      a:'Lagerware verlässt unser Haus in der Regel innerhalb von ein bis zwei Werktagen, Kompletträder innerhalb von zwei bis vier Werktagen, da sie montiert und gewuchtet werden. Das voraussichtliche Lieferdatum siehst du im Warenkorb.' },\n    { g:'BESTELLUNG & VERSAND', q:'Kann ich Felgen zurückgeben?',\n      a:'Ja. Es gilt das gesetzliche Widerrufsrecht von 14 Tagen. Montierte und gefahrene Kompletträder können wir nur zurücknehmen, wenn sie unbeschädigt und unbenutzt sind. Melde dich einfach vorher kurz bei uns.' }\n  ];\n\n  var warum = [\n    { icon:'shield', t:'Geprüfte Freigabe, kein Risiko',\n      b:'Jede Felge, die wir dir zeigen, ist für dein Fahrzeug durch ein Gutachten freigegeben. Auflagen nennen wir im Klartext – vor dem Kauf, nicht danach. Das Gutachten kannst du auf jeder Produktseite herunterladen.' },\n    { icon:'wheel', t:'Komplettrad, fertig montiert',\n      b:'Auf Wunsch ziehen wir die Reifen auf und wuchten die Räder bei uns im Haus. Du bekommst fertige Räder inklusive Ventilen, Anbauset und ABE – auspacken, anschrauben, losfahren.' },\n    { icon:'truck', t:'Versand aus Deutschland',\n      b:'Über 150 Modelle liegen bei uns auf Lager. Bestellungen bis 14 Uhr gehen am selben Werktag raus, versichert mit DHL. Fragen beantworten wir am Telefon, nicht per Formularbrief.' }\n  ];\n\n  var orders = [\n    { nr:'RMF-2026-04711', kunde:'M. Hartmann', fzg:'BMW 3er Coupe', total:1425.00, status:'BEZAHLT' },\n    { nr:'RMF-2026-04710', kunde:'S. Weiß', fzg:'Audi RS 4 Avant', total:2189.00, status:'IN BEARBEITUNG' },\n    { nr:'RMF-2026-04709', kunde:'T. Bergmann', fzg:'VW Golf VIII', total:864.50, status:'VERSENDET' },\n    { nr:'RMF-2026-04708', kunde:'K. Lorenz', fzg:'Porsche Macan S', total:3120.00, status:'PROBLEM' },\n    { nr:'RMF-2026-04707', kunde:'A. Neumann', fzg:'Mercedes C-Klasse', total:1078.90, status:'BEZAHLT' },\n    { nr:'RMF-2026-04706', kunde:'J. Kraus', fzg:'Škoda Octavia', total:932.00, status:'STORNIERT' }\n  ];\n\n  var aktivitaet = [\n    { who:'Stefan M.', what:'Gutachten ABE 47231 veröffentlicht', when:'vor 12 Min.' },\n    { who:'Import', what:'PKW-Liste eingelesen · 25 Fahrzeuge geprüft', when:'heute 04:12' },\n    { who:'Nadine K.', what:'Konflikt bei BBS CI-R 9,5J gemeldet', when:'gestern 17:40' },\n    { who:'Stefan M.', what:'Preis BORBET Havanna 18\" angepasst', when:'gestern 15:02' },\n    { who:'System', what:'Bestand OZ Superturismo unter Schwelle', when:'gestern 09:18' }\n  ];\n\n  var legal = [\n    { id:'impressum', t:'Impressum', h:['Angaben gemäß § 5 TMG','Vertreten durch','Kontakt','Umsatzsteuer-ID','Streitschlichtung'] },\n    { id:'datenschutz', t:'Datenschutz', h:['Verantwortliche Stelle','Erhebung und Verarbeitung','Cookies und Reichweitenmessung','Deine Rechte','Aufbewahrungsfristen'] },\n    { id:'agb', t:'AGB', h:['Geltungsbereich','Vertragsschluss','Preise und Versandkosten','Lieferung','Eigentumsvorbehalt','Gewährleistung'] },\n    { id:'widerruf', t:'Widerrufsbelehrung', h:['Widerrufsrecht','Folgen des Widerrufs','Muster-Widerrufsformular','Ausschluss des Widerrufsrechts'] },\n    { id:'versand', t:'Versand', h:['Versandkosten','Lieferzeiten','Kompletträder','Speditionsversand','Sendungsverfolgung'] }\n  ];\n\n  w.RMF = {\n    wheels: wheels, tyres: tyres, makes: makes, keyIndex: keyIndex, lookup: lookup,\n    faq: faq, warum: warum, orders: orders, aktivitaet: aktivitaet, legal: legal,\n    eur: eur, dec: dec,\n    brands: ['BBS','YIDO','BORBET','OZ RACING','ALUTEC','rotiform'],\n    tiles: ['BMW','AUDI','MERCEDES','VW','PORSCHE','OPEL','FORD','ŠKODA'],\n    trust: ['Über 150 Modelle auf Lager','Gutachten zu jeder Felge','Versand aus Deutschland','Komplettrad montiert & gewuchtet'],\n    footerLine: 'RIMIFY liefert Felgen und Kompletträder für den deutschen Markt. Jede Felge mit gültigem Gutachten, jedes Rad geprüft, montiert und gewuchtet – versendet aus Deutschland.',\n    kontaktIntro: 'Fragen zur Passgenauigkeit, zu einer Bestellung oder zu einem Gutachten? Schreib uns oder ruf einfach an – wir antworten in der Regel noch am selben Werktag.',\n    pages: [\n      ['startseite','Startseite'],['felgen-suchen','Felgen suchen'],['felgen','Felgen (PLP)'],\n      ['produkt','Produkt (PDP)'],['rimify-check','RIMIFY-CHECK'],['check-ergebnis','Check-Ergebnis'],\n      ['warenkorb','Warenkorb'],['kasse','Kasse'],['bestellung','Bestellbestätigung'],\n      ['faq','FAQ'],['kontakt','Kontakt'],['rechtliches','Rechtliches'],['404','404'],\n      ['admin-anmelden','Admin · Anmelden'],['admin-dashboard','Admin · Dashboard'],\n      ['admin-gutachten','Admin · Gutachten'],['admin-rollen','Admin · Rollen']\n    ]\n  };\n})(window);\n"},"headersSize":358,"bodySize":18613,"redirectURL":"","_transferSize":18971},"cache":{},"timings":{"dns":0.008,"connect":0.988,"ssl":3.767,"send":0,"wait":5.271,"receive":7.251},"_frameref":"frame@0ae505f1a732736d1625028bc55564cb","_monotonicTime":69762.486,"_resourceType":"script","serverIPAddress":"127.0.0.1","_serverPort":5500,"_securityDetails":{}},{"pageref":"page@76b9a45bb084a7125d884186b129a128","startedDateTime":"2026-09-21T08:29:45.903Z","time":17.814999999999998,"request":{"method":"GET","url":"http://127.0.0.1:5500/shared/art.js","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Language","value":"de-DE"},{"name":"Referer","value":"http://127.0.0.1:5500/mobile/rimify-check.html"},{"name":"User-Agent","value":"Mozilla/5.0 (Linux; Android 14; Pixel 7) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Mobile Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\""},{"name":"sec-ch-ua-mobile","value":"?1"},{"name":"sec-ch-ua-platform","value":"\"Android\""}],"queryString":[],"headersSize":385,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept-Ranges","value":"bytes"},{"name":"Connection","value":"keep-alive"},{"name":"Date","value":"Mon, 21 Sep 2026 08:29:45 GMT"},{"name":"Keep-Alive","value":"timeout=5"},{"name":"cache-control","value":"no-cache, no-store, must-revalidate"},{"name":"content-length","value":"33674"},{"name":"content-type","value":"application/javascript; charset=UTF-8"},{"name":"etag","value":"W/\"3659174697470166-33674-2026-09-21T05:37:15.935Z\""},{"name":"last-modified","value":"Mon, 21 Sep 2026 05:37:15 GMT"}],"content":{"size":33674,"mimeType":"application/javascript; charset=UTF-8","compression":0,"text":"/* RIMIFY — SVG artwork generators. Everything visual on the site is drawn here. */\n(function (w) {\n  'use strict';\n\n  var uidn = 0;\n  function uid(p) { uidn += 1; return (p || 'a') + uidn; }\n  function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }\n\n  var FIN = {\n    graphite: { a:'#3A3E45', b:'#1C1F24', face:'#2A2E34', lo:'#14171B', li:'#565B63', cap:'#4A4F57' },\n    silver:   { a:'#D8DBE0', b:'#9BA1AA', face:'#C3C8CF', lo:'#7C838D', li:'#F1F3F6', cap:'#CFD4DA' },\n    black:    { a:'#1A1C20', b:'#0A0B0D', face:'#16181C', lo:'#050607', li:'#34373D', cap:'#2A2D33' },\n    bronze:   { a:'#8A6A3C', b:'#4E3A1F', face:'#6F552F', lo:'#372813', li:'#B9915A', cap:'#7E5F33' },\n    polished: { a:'#E9ECEF', b:'#A8AEB6', face:'#D5DAE0', lo:'#8B929B', li:'#FFFFFF', cap:'#DEE3E8' }\n  };\n\n  function pt(cx, cy, r, deg) {\n    var a = (deg - 90) * Math.PI / 180;\n    return [cx + r * Math.cos(a), cy + r * Math.sin(a)];\n  }\n  function f(n) { return Math.round(n * 100) / 100; }\n\n  /* ── 4.1 wheelSVG ───────────────────────────────────── */\n  function wheelSVG(o) {\n    o = o || {};\n    var n = o.spokes || 10, fin = FIN[o.finish] || FIN.graphite, cap = (o.cap || 'R').charAt(0);\n    var tyre = !!o.tyre, shadow = o.shadow !== false;\n    var id = uid('w'), C = 200;\n    var s = [];\n\n    s.push('<defs>');\n    s.push('<linearGradient id=\"lip' + id + '\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">' +\n      '<stop offset=\"0\" stop-color=\"' + fin.a + '\"/><stop offset=\".48\" stop-color=\"' + fin.b + '\"/>' +\n      '<stop offset=\".72\" stop-color=\"' + fin.a + '\"/><stop offset=\"1\" stop-color=\"' + fin.lo + '\"/></linearGradient>');\n    s.push('<radialGradient id=\"fc' + id + '\" cx=\"38%\" cy=\"32%\" r=\"82%\">' +\n      '<stop offset=\"0\" stop-color=\"#1B1F26\"/><stop offset=\".6\" stop-color=\"#0C0E12\"/>' +\n      '<stop offset=\"1\" stop-color=\"#040507\"/></radialGradient>');\n    s.push('<linearGradient id=\"sp' + id + '\" x1=\".15\" y1=\"0\" x2=\".85\" y2=\"1\">' +\n      '<stop offset=\"0\" stop-color=\"' + fin.li + '\"/><stop offset=\".42\" stop-color=\"' + fin.a + '\"/>' +\n      '<stop offset=\".78\" stop-color=\"' + fin.face + '\"/><stop offset=\"1\" stop-color=\"' + fin.lo + '\"/></linearGradient>');\n    s.push('<radialGradient id=\"cp' + id + '\" cx=\"36%\" cy=\"30%\" r=\"80%\">' +\n      '<stop offset=\"0\" stop-color=\"' + fin.li + '\"/><stop offset=\"1\" stop-color=\"' + fin.lo + '\"/></radialGradient>');\n    if (shadow) s.push('<filter id=\"bl' + id + '\" x=\"-30%\" y=\"-60%\" width=\"160%\" height=\"260%\"><feGaussianBlur stdDeviation=\"9\"/></filter>');\n    s.push('</defs>');\n\n    if (shadow) s.push('<ellipse cx=\"200\" cy=\"' + (tyre ? 384 : 352) + '\" rx=\"150\" ry=\"14\" fill=\"#0E1116\" opacity=\".16\" filter=\"url(#bl' + id + ')\"/>');\n\n    if (tyre) {\n      s.push('<circle cx=\"200\" cy=\"200\" r=\"196\" fill=\"#15171B\"/>');\n      s.push('<circle cx=\"200\" cy=\"200\" r=\"196\" fill=\"none\" stroke=\"#000\" stroke-opacity=\".55\" stroke-width=\"2\"/>');\n      var tread = [];\n      for (var t = 0; t < 34; t++) {\n        var a1 = pt(C, C, 196, t * (360 / 34)), a2 = pt(C, C, 176, t * (360 / 34) + 3.2);\n        tread.push('M' + f(a1[0]) + ' ' + f(a1[1]) + 'L' + f(a2[0]) + ' ' + f(a2[1]));\n      }\n      s.push('<path d=\"' + tread.join('') + '\" stroke=\"#0B0C0F\" stroke-width=\"7\" stroke-linecap=\"round\" fill=\"none\"/>');\n      s.push('<circle cx=\"200\" cy=\"200\" r=\"168\" fill=\"none\" stroke=\"#24272C\" stroke-width=\"3\"/>');\n      s.push('<circle cx=\"200\" cy=\"200\" r=\"158\" fill=\"#1B1E23\"/>');\n    }\n\n    s.push('<circle cx=\"200\" cy=\"200\" r=\"150\" fill=\"url(#lip' + id + ')\"/>');\n    s.push('<circle cx=\"200\" cy=\"200\" r=\"142\" fill=\"none\" stroke=\"' + fin.li + '\" stroke-opacity=\".35\" stroke-width=\"1.5\"/>');\n    s.push('<circle cx=\"200\" cy=\"200\" r=\"136\" fill=\"#000\" opacity=\".5\"/>');\n    s.push('<circle cx=\"200\" cy=\"200\" r=\"131\" fill=\"url(#fc' + id + ')\"/>');\n\n    /* spokes */\n    var ri = 44, ro = 130;\n    var ai = (Math.PI / n) * 0.24, ao = (Math.PI / n) * 0.48;\n    function P(r, rad) { return [f(C + r * Math.sin(rad)), f(C - r * Math.cos(rad))]; }\n    var p1 = P(ri, -ai), p2 = P(ro, -ao), p3 = P(ro, ao), p4 = P(ri, ai);\n    var d = 'M' + p1[0] + ' ' + p1[1] + 'L' + p2[0] + ' ' + p2[1] +\n      'A' + ro + ' ' + ro + ' 0 0 1 ' + p3[0] + ' ' + p3[1] +\n      'L' + p4[0] + ' ' + p4[1] + 'A' + ri + ' ' + ri + ' 0 0 0 ' + p1[0] + ' ' + p1[1] + 'Z';\n    s.push('<g>');\n    for (var i = 0; i < n; i++) {\n      var rot = i * 360 / n;\n      s.push('<path d=\"' + d + '\" fill=\"url(#sp' + id + ')\" stroke=\"' + fin.lo + '\" stroke-width=\"1\" stroke-opacity=\".9\" transform=\"rotate(' + f(rot) + ' 200 200)\"/>');\n      s.push('<path d=\"' + d + '\" fill=\"none\" stroke=\"' + fin.li + '\" stroke-width=\"1\" stroke-opacity=\".5\" transform=\"rotate(' + f(rot) + ' 200 200) translate(-1.4 -1.4)\"/>');\n    }\n    s.push('</g>');\n\n    /* hub plate */\n    s.push('<circle cx=\"200\" cy=\"200\" r=\"64\" fill=\"url(#sp' + id + ')\"/>');\n    s.push('<circle cx=\"200\" cy=\"200\" r=\"64\" fill=\"none\" stroke=\"' + fin.lo + '\" stroke-width=\"1\" stroke-opacity=\".8\"/>');\n\n    /* bolt circle */\n    for (var b = 0; b < 5; b++) {\n      var bp = pt(C, C, 52, b * 72 + 18);\n      s.push('<circle cx=\"' + f(bp[0]) + '\" cy=\"' + f(bp[1]) + '\" r=\"9\" fill=\"' + fin.lo + '\"/>');\n      s.push('<path d=\"M' + f(bp[0] - 7.5) + ' ' + f(bp[1] + 3) + 'A9 9 0 0 0 ' + f(bp[0] + 7.5) + ' ' + f(bp[1] + 3) + '\" fill=\"none\" stroke=\"' + fin.li + '\" stroke-opacity=\".5\" stroke-width=\"1.4\"/>');\n    }\n\n    /* centre cap */\n    s.push('<circle cx=\"200\" cy=\"200\" r=\"34\" fill=\"url(#cp' + id + ')\"/>');\n    s.push('<circle cx=\"200\" cy=\"200\" r=\"34\" fill=\"none\" stroke=\"' + fin.lo + '\" stroke-width=\"1.2\"/>');\n    s.push('<text x=\"200\" y=\"208\" text-anchor=\"middle\" font-family=\"Lato,sans-serif\" font-weight=\"900\" font-size=\"20\" fill=\"' + (o.finish === 'silver' || o.finish === 'polished' ? '#3A3E45' : '#EDEFF3') + '\" opacity=\".85\">' + esc(cap) + '</text>');\n\n    /* specular */\n    var sa = pt(C, C, 145, 200), sb = pt(C, C, 145, 320);\n    s.push('<path d=\"M' + f(sa[0]) + ' ' + f(sa[1]) + 'A145 145 0 0 1 ' + f(sb[0]) + ' ' + f(sb[1]) + '\" fill=\"none\" stroke=\"#fff\" stroke-opacity=\".18\" stroke-width=\"5\" stroke-linecap=\"round\"/>');\n    var sc = pt(C, C, 148, 318), sd = pt(C, C, 148, 352);\n    s.push('<path d=\"M' + f(sc[0]) + ' ' + f(sc[1]) + 'A148 148 0 0 1 ' + f(sd[0]) + ' ' + f(sd[1]) + '\" fill=\"none\" stroke=\"#fff\" stroke-opacity=\".10\" stroke-width=\"3\" stroke-linecap=\"round\"/>');\n\n    return '<svg viewBox=\"0 0 400 400\" width=\"100%\" height=\"100%\" role=\"img\" aria-label=\"Felge\">' + s.join('') + '</svg>';\n  }\n\n  /* ── 4.2 carSVG ─────────────────────────────────────── */\n  function carSVG(o) {\n    o = o || {};\n    var dark = o.variant === 'dark';\n    var id = uid('c');\n    var g1 = dark ? '#23262B' : '#E8EAEE', g2 = dark ? '#0E1014' : '#A9AFB8';\n    var body = 'M72 362C66 330 78 300 104 288L300 250L392 246C430 244 452 232 470 212L556 150' +\n      'C572 138 592 132 614 132L742 132C790 132 828 146 856 170L946 240L1058 248' +\n      'C1102 252 1126 272 1132 308L1136 342C1138 366 1126 380 1104 382L1060 384' +\n      'A96 96 0 0 0 868 384L452 390A104 104 0 0 0 244 390L96 388C80 386 72 376 72 362Z';\n    var s = [];\n    s.push('<defs><linearGradient id=\"bd' + id + '\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">' +\n      '<stop offset=\"0\" stop-color=\"' + g1 + '\"/><stop offset=\".55\" stop-color=\"' + g2 + '\"/>' +\n      '<stop offset=\"1\" stop-color=\"' + (dark ? '#06070A' : '#7E858F') + '\"/></linearGradient>' +\n      '<filter id=\"gs' + id + '\" x=\"-20%\" y=\"-60%\" width=\"140%\" height=\"260%\"><feGaussianBlur stdDeviation=\"14\"/></filter></defs>');\n    s.push('<ellipse cx=\"620\" cy=\"452\" rx=\"470\" ry=\"26\" fill=\"#05070B\" opacity=\".55\" filter=\"url(#gs' + id + ')\"/>');\n    /* wheel wells */\n    s.push('<circle cx=\"348\" cy=\"384\" r=\"112\" fill=\"#06080C\"/><circle cx=\"964\" cy=\"384\" r=\"104\" fill=\"#06080C\"/>');\n    /* wheels behind body */\n    s.push('<svg x=\"240\" y=\"276\" width=\"216\" height=\"216\" viewBox=\"0 0 400 400\">' + wheelSVG({ spokes: o.spokes || 10, finish: o.wheel || 'graphite', cap: 'R', shadow: false }) + '</svg>');\n    s.push('<svg x=\"864\" y=\"284\" width=\"200\" height=\"200\" viewBox=\"0 0 400 400\">' + wheelSVG({ spokes: o.spokes || 10, finish: o.wheel || 'graphite', cap: 'R', shadow: false }) + '</svg>');\n    s.push('<path d=\"' + body + '\" fill=\"url(#bd' + id + ')\"/>');\n    /* glass */\n    s.push('<path d=\"M486 210L562 154C578 142 596 140 616 140L738 140C780 140 814 152 838 176L910 232Z\" fill=\"#151A22\" opacity=\".9\"/>');\n    s.push('<path d=\"M628 140L634 232\" stroke=\"#0B0E13\" stroke-width=\"5\" opacity=\".7\"/>');\n    /* shoulder specular */\n    s.push('<path d=\"M118 288L300 252L392 248C432 246 456 234 474 214\" fill=\"none\" stroke=\"#fff\" stroke-opacity=\".35\" stroke-width=\"2\"/>');\n    s.push('<path d=\"M470 316L1080 302\" fill=\"none\" stroke=\"#fff\" stroke-opacity=\".14\" stroke-width=\"2\"/>');\n    /* lights */\n    s.push('<path d=\"M96 300L184 286C196 284 204 290 204 300L204 312C204 320 198 324 190 324L98 322Z\" fill=\"' + (dark ? '#8FA6FF' : '#F2F5FC') + '\" opacity=\".85\"/>');\n    s.push('<path d=\"M1096 292L1130 296C1136 298 1138 302 1138 308L1136 322L1094 320Z\" fill=\"#B01018\" opacity=\".7\"/>');\n    /* sill shadow */\n    s.push('<path d=\"M452 390L868 384\" stroke=\"#05070B\" stroke-opacity=\".45\" stroke-width=\"10\"/>');\n    return '<svg viewBox=\"0 0 1200 520\" width=\"100%\" height=\"100%\" preserveAspectRatio=\"xMidYMax meet\" role=\"img\" aria-label=\"Fahrzeug\">' + s.join('