{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && vite build --ssr",
        "dev": "vite",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "e2e": "playwright test",
        "lint": "eslint resources/js e2e",
        "lint:css": "stylelint \"resources/css/**/*.css\" \"resources/js/**/*.vue\"",
        "format": "prettier --write resources/js e2e",
        "qa": "node scripts/qa/overflow.mjs && node scripts/qa/console.mjs && node scripts/qa/axe.mjs && node scripts/qa/style-inventory.mjs",
        "qa:shots": "node scripts/qa/review-shots.mjs",
        "qa:lighthouse": "node scripts/qa/lighthouse.mjs",
        "ocr:assets": "node scripts/ocr-assets.mjs",
        "3d:assets": "node scripts/3d/decoders.mjs && node scripts/3d/build-wheel.mjs",
        "3d:frames": "node scripts/3d/render-frames.mjs",
        "visual": "playwright test -c playwright.visual.config.ts",
        "visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@eslint/js": "^10.0.1",
        "@gltf-transform/cli": "^4.5.0",
        "@lhci/cli": "^0.15.1",
        "@playwright/test": "^1.63.0",
        "@types/dompurify": "^3.0.5",
        "@types/node": "^26.6.2",
        "@types/three": "^0.186.0",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vitest/coverage-v8": "^5.0.1",
        "@vue/test-utils": "^2.5.1",
        "concurrently": "^10.0.3",
        "dompurify": "^3.4.15",
        "eslint": "^10.11.0",
        "eslint-plugin-vue": "^10.11.0",
        "fontaine": "^0.8.2",
        "globals": "^17.12.0",
        "happy-dom": "^20.14.5",
        "laravel-vite-plugin": "^3.1",
        "postcss-html": "^2.0.0",
        "prettier": "^3.9.8",
        "sharp": "^0.35.4",
        "stylelint": "^17.15.0",
        "stylelint-declaration-strict-value": "^1.12.1",
        "tesseract.js": "^7.0.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.0",
        "vitest": "^5.0.1",
        "vue-tsc": "^3.3.11"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@fontsource-variable/archivo": "^5.3.0",
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@fontsource/lato": "^5.3.0",
        "@inertiajs/vue3": "^3.7.1",
        "@tresjs/cientos": "^5.9.0",
        "@tresjs/core": "^5.9.0",
        "@vueuse/core": "^15.0.0",
        "pinia": "^4.0.3",
        "reka-ui": "^2.10.5",
        "three": "^0.186.0",
        "vue": "^3.5.43",
        "ziggy-js": "^2.6.4"
    }
}
