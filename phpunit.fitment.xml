<?xml version="1.0" encoding="UTF-8"?>
<!--
    composer verify:fitment (D-433): the fitment engine at 100 %, measured over every test in the suite — a branch of
    app/Domain/Fitment that a storefront or admin test drives is tested. The same suites as phpunit.xml; only the code
    measured is narrowed, because Pest's coverage filter does not narrow the report or the minimum.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app/Domain/Fitment</directory>
        </include>
    </source>
</phpunit>
